{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Активные challenge</h1>
  <p class="page-sub">Выданные коды и push-подтверждения (без самих кодов).</p>
</header>

{{if .Challenges}}
<section class="card">
  <div class="table-wrap">
    <table class="table">
      <tr><th>Пользователь</th><th>Канал</th><th>Назначение</th><th>Истекает</th><th>Состояние push</th><th>Попыток</th></tr>
      {{range .Challenges}}
      <tr>
        <td class="cell-strong">{{index $.Usernames .UserID}}</td>
        <td><span class="badge neutral">{{.Channel}}</span></td>
        <td>{{.Purpose}}</td>
        <td class="nowrap">{{dt .ExpiresAt}}</td>
        <td>{{if .PushState}}<span class="badge {{if eq (deref .PushState) "approved"}}ok{{else}}warn{{end}}">{{deref .PushState}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
        <td>{{.AttemptsLeft}}</td>
      </tr>
      {{end}}
    </table>
  </div>
</section>
{{else}}
<section class="card">
  <div class="empty">
    <p>Активных challenge нет.</p>
    <p class="help">Здесь появляются ожидающие подтверждения коды и
    push-запросы.</p>
  </div>
</section>
{{end}}
{{end}}
