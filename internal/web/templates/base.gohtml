<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}} · 2FA</title>
<link rel="stylesheet" href="/static/style.css">
<script src="/static/webauthn.js" defer></script>
<script src="/static/app.js" defer></script>
</head>
<body>
{{template "layout" .}}
</body>
</html>

{{/* layout_app — каркас приложения: боковое меню + контент. */}}
{{define "layout_app"}}
<div class="app">
  <aside class="sidebar">
    <a class="brand" href="/me"><span class="brand-mark">L</span>Ligament</a>
    <nav class="nav">
      <div class="nav-section">Кабинет</div>
      <a class="nav-link{{if eq .Nav "me"}} active{{end}}" href="/me">Профиль</a>
      <a class="nav-link{{if eq .Nav "totp"}} active{{end}}" href="/me/totp">Приложение TOTP</a>
      <a class="nav-link{{if eq .Nav "backup"}} active{{end}}" href="/me/backup">Резервные коды</a>
      <a class="nav-link{{if eq .Nav "telegram"}} active{{end}}" href="/me/telegram">Telegram</a>
      <a class="nav-link{{if eq .Nav "passkeys"}} active{{end}}" href="/me/passkeys">Passkeys</a>
      <a class="nav-link{{if eq .Nav "devices"}} active{{end}}" href="/me/devices">Устройства</a>
      {{if .IsAdmin}}
      <div class="nav-section">Админ</div>
      <a class="nav-link{{if eq .Nav "admin-users"}} active{{end}}" href="/admin/users">Пользователи</a>
      <a class="nav-link{{if eq .Nav "admin-audit"}} active{{end}}" href="/admin/audit">Аудит</a>
      <a class="nav-link{{if eq .Nav "admin-firewall"}} active{{end}}" href="/admin/firewall">Файрвол</a>
      <a class="nav-link{{if eq .Nav "admin-oidc"}} active{{end}}" href="/admin/oidc">OIDC</a>
      <a class="nav-link{{if eq .Nav "admin-challenges"}} active{{end}}" href="/admin/challenges">Активные challenge</a>
      <a class="nav-link{{if eq .Nav "admin-settings"}} active{{end}}" href="/admin/settings">Настройки</a>
      <a class="nav-link{{if eq .Nav "admin-license"}} active{{end}}" href="/admin/license">Лицензия</a>
      <a class="nav-link{{if eq .Nav "admin-api"}} active{{end}}" href="/api/docs">API</a>
      {{end}}
    </nav>
    {{if and .Ads.Show .Ads.Sidebar}}<div class="ad-slot ad-side" id="adv-sidebar" data-rtb-block="{{.Ads.Sidebar}}"></div>{{end}}
    {{if and .Ads.Show (eq .Ads.Provider "direct")}}{{template "ad_direct" (dict "URL" .Ads.DirectURL "Label" .Ads.DirectLabel "Image" .Ads.DirectImage)}}{{end}}
    <div class="sidebar-foot">
      <div class="sidebar-user" title="{{.Username}}">{{.Username}}</div>
      <form action="/logout" method="post" class="logout-form">
        {{csrf .CSRF}}
        <button type="submit" class="btn ghost sm">Выйти</button>
      </form>
    </div>
  </aside>
  <div class="app-main">
    <main class="content">
      {{with .Flash}}<div class="flash ok"><span class="flash-icon">✅</span>{{.}}</div>{{end}}
      {{with .FlashErr}}<div class="flash err"><span class="flash-icon">⚠️</span>{{.}}</div>{{end}}
      {{range .LicenseWarnings}}<div class="flash err"><span class="flash-icon">⚠️</span>{{.}}</div>{{end}}
      {{template "content" .}}
    </main>
    <footer class="app-footer">Ligament</footer>
    {{template "ads_scripts" .}}
  </div>
</div>
{{end}}

{{/* layout_center — центрированная карточка (login, ошибки). */}}
{{define "layout_center"}}
<div class="center-wrap">
  {{if and .Ads.Show .Ads.LoginLeft}}<aside class="ad-slot ad-side" id="adv-login-left" data-rtb-block="{{.Ads.LoginLeft}}"></aside>{{end}}
  {{if and .Ads.Show (eq .Ads.Provider "direct")}}{{template "ad_direct" (dict "URL" .Ads.DirectURL "Label" .Ads.DirectLabel "Image" .Ads.DirectImage)}}{{end}}
  <main class="center-main">
    {{with .Flash}}<div class="flash ok"><span class="flash-icon">✅</span>{{.}}</div>{{end}}
    {{with .FlashErr}}<div class="flash err"><span class="flash-icon">⚠️</span>{{.}}</div>{{end}}
    {{template "content" .}}
  </main>
  {{if and .Ads.Show .Ads.LoginRight}}<aside class="ad-slot ad-side" id="adv-login-right" data-rtb-block="{{.Ads.LoginRight}}"></aside>{{end}}
  {{if and .Ads.Show (eq .Ads.Provider "direct")}}{{template "ad_direct" (dict "URL" .Ads.DirectURL "Label" .Ads.DirectLabel "Image" .Ads.DirectImage)}}{{end}}
  <footer class="center-footer">Ligament</footer>
</div>
{{template "ads_scripts" .}}
{{end}}

{{/* ads_scripts — загрузчик РСЯ: только на бесплатной лицензии и при
     настроенных блоках (CSP для yandex доменов расширяется тем же
     условием в securityHeaders). */}}
{{/* ad_direct — слот direct-link сети: кликабельная ссылка/баннер,
     домен площадки не нужен. */}}
{{define "ad_direct"}}
<aside class="ad-slot ad-side">
  <div class="ad-card">
    <div class="ad-brand">
      <span class="brand-mark">L</span><span class="ad-name">Ligament</span>
      <span class="ad-badge">Реклама</span>
    </div>
    {{if .URL}}
    <a class="ad-link" href="{{.URL}}" target="_blank" rel="noopener noreferrer nofollow">
      {{if .Image}}<img class="ad-img" src="{{.Image}}" alt="Реклама" loading="lazy">
      {{else}}<span class="ad-title">{{if .Label}}{{.Label}}{{else}}Партнёрское предложение{{end}}</span>{{end}}
      <span class="ad-go">Перейти&nbsp;→</span>
    </a>
    {{else}}
    <div class="ad-title">Бесплатная версия</div>
    <div class="ad-hint">Блок рекламы отключается активацией лицензии</div>
    {{end}}
  </div>
</aside>
{{end}}

{{define "ads_scripts"}}
{{if and .Ads.Show (eq .Ads.Provider "rsya") (or .Ads.LoginLeft (or .Ads.LoginRight .Ads.Sidebar))}}
<script src="https://yandex.st/ads/system/context.js" async></script>
<script src="/static/ads.js" defer></script>
{{end}}
{{end}}
