{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Пользователи</h1>
  <p class="page-sub">Все учётные записи сервера: роли, каналы кодов и
  чувствительные действия.</p>
</header>

{{if .BackupCodes}}
<section class="card">
  <div class="card-head">
    <h2>Новые резервные коды</h2>
    <p>Выданы после сброса TOTP — передайте их пользователю безопасным
    способом.</p>
  </div>
  <div class="flash err"><span class="flash-icon">⚠️</span>Показываются только один раз — сохраните!</div>
  <ul class="codes">
    {{range .BackupCodes}}<li><code>{{.}}</code></li>{{end}}
  </ul>
</section>
{{end}}

{{if .Edit}}
<section class="card card-edit-user" id="edit-user">
  <div class="card-head users-card-head">
    <div>
      <h2>Редактирование: {{.Edit.Username}}</h2>
      <p>Пустой пароль — оставить текущий.</p>
    </div>
    <div>
      <a href="/admin/users" class="btn secondary sm">✕ Отмена / Закрыть</a>
    </div>
  </div>
  {{if .Edit.LDAPLocked}}
  <div class="flash err" style="margin-bottom: 1rem;">
    <span class="flash-icon">⛔</span>
    <b>Учётная запись отключена или заблокирована в Active Directory / LDAP.</b><br>
    Пользователь заблокирован в домене (флаг ACCOUNTDISABLE или LOCKOUT в userAccountControl). Доступ ограничен до разблокировки администратором домена.
  </div>
  {{end}}
  <form action="/admin/users/{{.Edit.ID}}" method="post" class="form wide">
    {{csrf .CSRF}}
    <input type="hidden" name="do" value="save">
    {{template "userFields" .}}
  </form>
</section>

{{if .EditAppDevices}}
<section class="card card-mt">
  <div class="card-head">
    <h2>Клиентские приложения и безопасность устройств (Телеметрия)</h2>
    <p>Устройства Windows, macOS, Android и iOS, авторизованные под пользователем <b>{{.Edit.Username}}</b></p>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Устройство</th>
          <th>Платформа и ОС</th>
          <th>Телеметрия (GPO / MDM / EDR)</th>
          <th>IP и активность</th>
          <th>Соответствие</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{range .EditAppDevices}}
        <tr>
          <td>
            <strong>{{.DeviceName}}</strong>
            {{if .AppVersion}}<div class="help">v{{.AppVersion}}</div>{{end}}
          </td>
          <td>
            <span class="badge">{{.Platform}}</span>
            {{if .OSVersion}}<div class="help">{{.OSVersion}}</div>{{end}}
          </td>
          <td>
            {{$posture := .SecurityPosture}}
            <div class="posture-badges">
              {{if eq .Platform "windows"}}
                {{if eq (index $posture "bitlocker") "encrypted"}}
                  <span class="badge success" title="BitLocker активен">BitLocker: OK</span>
                {{else if index $posture "bitlocker"}}
                  <span class="badge danger" title="BitLocker отключен">BitLocker: {{index $posture "bitlocker"}}</span>
                {{end}}
                {{if eq (index $posture "defender") "active"}}
                  <span class="badge success" title="Windows Defender активен">Defender: OK</span>
                {{end}}
                {{if eq (index $posture "firewall") "active"}}
                  <span class="badge success" title="Брандмауэр включен">Firewall: OK</span>
                {{end}}
              {{end}}
              {{if eq .Platform "macos"}}
                {{if eq (index $posture "filevault") "encrypted"}}
                  <span class="badge success" title="FileVault шифрование активно">FileVault: OK</span>
                {{else if index $posture "filevault"}}
                  <span class="badge danger" title="FileVault выключен">FileVault: {{index $posture "filevault"}}</span>
                {{end}}
                {{if eq (index $posture "gatekeeper") "active"}}
                  <span class="badge success" title="Gatekeeper защита активна">Gatekeeper: OK</span>
                {{end}}
                {{if eq (index $posture "firewall") "active"}}
                  <span class="badge success" title="Сетевой экран macOS включен">Firewall: OK</span>
                {{end}}
                {{if index $posture "touch_id"}}
                  <span class="badge info" title="Touch ID поддерживается">Touch ID</span>
                {{end}}
              {{end}}
              {{if or (index $posture "rooted") (index $posture "jailbroken")}}
                <span class="badge danger" title="Обнаружен Root или Jailbreak">Root/Jailbreak</span>
              {{else if or (eq .Platform "android") (eq .Platform "ios")}}
                <span class="badge success" title="Целостность ОС не нарушена">Целостность: OK</span>
              {{end}}
              {{if index $posture "disk_warning"}}
                <span class="badge danger" title="{{index $posture "disk_details"}}">💾 Диск: {{index $posture "disk_percent"}}% (своб. {{index $posture "disk_free_gb"}} ГБ)</span>
              {{else if index $posture "disk_free_gb"}}
                <span class="badge success" title="{{index $posture "disk_details"}}">💾 Диск: {{index $posture "disk_free_gb"}} ГБ своб.</span>
              {{end}}
              {{if index $posture "cpu_warning"}}
                <span class="badge danger" title="Высокая нагрузка CPU: {{index $posture "cpu_percent"}}%">⚡ CPU: {{index $posture "cpu_percent"}}%</span>
              {{end}}
            </div>
          </td>
          <td>
            <div>{{.LastIP}}</div>
            <div class="help">{{dt .LastSeenAt}}</div>
          </td>
          <td>
            {{if .Active}}
              {{if index .SecurityPosture "is_compliant"}}
                <span class="badge success">Соответствует</span>
              {{else}}
                <span class="badge danger">Нарушение политик</span>
              {{end}}
            {{else}}
              <span class="badge">Отозвано</span>
            {{end}}
          </td>
          <td>
            {{if .Active}}
            <form action="/admin/users/{{$.Edit.ID}}/app-devices/{{.ID}}/delete" method="post" class="form-inline">
              {{csrf $.CSRF}}
              <button type="submit" class="btn danger sm">Отозвать</button>
            </form>
            {{end}}
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>
{{end}}
{{else}}
<section class="card" id="new-user">
  <div class="card-head">
    <h2>Новый пользователь</h2>
    <p>Имя и пароль обязательны; остальное можно изменить позже.</p>
  </div>
  <form action="/admin/users" method="post" class="form wide">
    {{csrf .CSRF}}
    {{template "userFields" .}}
  </form>
</section>
{{end}}

<section class="card">
  <div class="card-head users-card-head">
    <div>
      <h2>Список пользователей</h2>
      <p>Действия применяются сразу; удаление необратимо.</p>
    </div>
    <div>
      <a href="#new-user" class="btn primary sm">➕ Новый пользователь</a>
    </div>
  </div>

  <div class="users-toolbar">
    <div class="users-search-box">
      <span class="search-icon">🔍</span>
      <input type="text" id="users-search" class="input" placeholder="Поиск по имени, логину, почте, телефону или группе..." autocomplete="off">
      <button type="button" id="users-search-clear" class="search-clear is-hidden" title="Очистить">&times;</button>
    </div>
    <div class="users-filter-pills" id="users-filter-pills">
      <button type="button" class="users-pill active" data-filter="all">Все <span class="count" id="count-all">{{.CountAll}}</span></button>
      <button type="button" class="users-pill" data-filter="ldap">🏢 LDAP <span class="count" id="count-ldap">{{.CountLDAP}}</span></button>
      <button type="button" class="users-pill" data-filter="local">🔑 Локальные <span class="count" id="count-local">{{.CountLocal}}</span></button>
      <button type="button" class="users-pill" data-filter="admin">🛡️ Админы <span class="count" id="count-admin">{{.CountAdmin}}</span></button>
      <button type="button" class="users-pill" data-filter="disabled">⚠️ Отключённые <span class="count" id="count-disabled">{{.CountDisabled}}</span></button>
      <button type="button" class="users-pill pill-danger" data-filter="ad-locked" title="Пользователи, отключённые или заблокированные в Active Directory">⛔ Заблокированы в АД <span class="count" id="count-ad-locked">{{.CountADLocked}}</span></button>
    </div>
  </div>

  <div class="table-wrap">
    <table class="table users-table" id="users-table">
      <thead>
        <tr>
          <th>Пользователь</th>
          <th>Источник / Статус</th>
          <th>Группы</th>
          <th>2FA & Сеть</th>
          <th class="th-right">Действия</th>
        </tr>
      </thead>
      <tbody>
      {{range .Users}}
      {{$ug := index $.UserGroups .ID}}
      <tr class="user-row{{if not .Enabled}} row-off{{end}}{{if .LDAPLocked}} row-ad-locked{{end}}"
          data-username="{{.Username}}"
          data-name="{{.DisplayName}}"
          data-email="{{.Email}}"
          data-phone="{{.Phone}}"
          data-source="{{.Source}}"
          data-role="{{.Role}}"
          data-enabled="{{if .Enabled}}1{{else}}0{{end}}"
          data-ad-locked="{{if .LDAPLocked}}1{{else}}0{{end}}"
          data-groups="{{range $ug}}{{.}} {{end}}{{range .LDAPGroups}}{{groupCN .}} {{.}}{{end}}">
        <td>
          <div class="user-profile-cell">
            <div class="user-avatar" data-avatar-bg="{{userAvatarBg .Username}}">
              {{userInitials .DisplayName .Username}}
            </div>
            <div class="user-names">
              <div class="user-primary-name">
                <a class="user-name-link" href="/admin/users/{{.ID}}">
                  {{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}
                </a>
                {{if and .DisplayName (ne .DisplayName .Username)}}
                  <span class="muted user-login-hint">@{{.Username}}</span>
                {{end}}
              </div>
              <div class="user-secondary-name">
                {{if .Email}}<span>✉️ {{.Email}}</span>{{end}}
                {{if and .Email .Phone}}<span class="dot-sep">•</span>{{end}}
                {{if .Phone}}<span>📱 {{.Phone}}</span>{{end}}
                {{if and (not .Email) (not .Phone)}}
                  <span class="muted">ID: {{printf "%.8s" .ID}}</span>
                {{end}}
              </div>
            </div>
          </div>
        </td>
        <td>
          <div class="badges-col-start">
            <div class="badges-row">
              {{if eq .Source "ldap"}}
                <span class="badge warn" title="Синхронизирован из Active Directory / LDAP">ldap</span>
              {{else}}
                <span class="badge neutral" title="Локальная учётная запись сервера">local</span>
              {{end}}
              <span class="badge {{if eq .Role "admin"}}ok{{else}}neutral{{end}}">{{.Role}}</span>
            </div>
            <div>
              {{if .LDAPLocked}}
                <span class="badge danger badge-xs font-weight-bold" title="Учётная запись отключена или заблокирована в Active Directory / LDAP">⛔ Заблокирован в АД</span>
              {{else if .Enabled}}
                <span class="badge ok badge-xs">активен</span>
              {{else}}
                <span class="badge err badge-xs">отключён</span>
              {{end}}
            </div>
            {{if or .IsSupportIT .IsSupport1C}}
            <div class="badges-row-wrap-mt">
              {{if .IsSupportIT}}<span class="badge info badge-xxs" title="Специалист IT-поддержки">IT-help</span>{{end}}
              {{if .IsSupport1C}}<span class="badge warn badge-xxs" title="Специалист по 1С">1C-help</span>{{end}}
            </div>
            {{end}}
          </div>
        </td>
        <td>
          <div class="user-groups-cell">
            {{if $ug}}
              {{range $ug}}<span class="badge info" title="Локальная группа">{{.}}</span>{{end}}
            {{end}}
            {{if .LDAPGroups}}
              {{$ldapLen := len .LDAPGroups}}
              {{if le $ldapLen 3}}
                {{range .LDAPGroups}}
                  <span class="badge neutral" title="LDAP DN: {{.}}">{{groupCN .}}</span>
                {{end}}
              {{else}}
                {{range $i, $g := .LDAPGroups}}
                  {{if lt $i 2}}
                    <span class="badge neutral" title="LDAP DN: {{$g}}">{{groupCN $g}}</span>
                  {{end}}
                {{end}}
                <span class="badge neutral cursor-help" title="{{range .LDAPGroups}}{{.}}&#10;{{end}}">+{{sub $ldapLen 2}} ещё</span>
              {{end}}
            {{end}}
            {{if and (not $ug) (not .LDAPGroups)}}
              <span class="muted muted-sm">—</span>
            {{end}}
          </div>
        </td>
        <td>
          <div class="user-2fa-cell">
            <div class="badges-row-wrap">
              {{if .PreferChannels}}
                {{range .PreferChannels}}
                  {{if eq . "app_push"}}
                    <span class="badge ok badge-xs" title="Push в мобильное/десктопное приложение Ligament">📱 app_push</span>
                  {{else}}
                    <span class="badge neutral badge-xs">{{.}}</span>
                  {{end}}
                {{end}}
              {{else}}
                <span class="muted muted-xs" title="Каналы не настроены">2FA: —</span>
              {{end}}
              {{if .RadiusPush}}
                {{if .TelegramLinked}}
                  <span class="badge ok badge-xs" title="RADIUS Push включен в профиле">Push: да</span>
                {{else}}
                  <span class="badge warn badge-xs" title="Push включен, но Telegram не привязан">⚠️ Push (нет ТГ)</span>
                {{end}}
              {{else}}
                {{$pushG := index $.InheritedPushGroup .ID}}
                {{if $pushG}}
                  {{if .TelegramLinked}}
                    <span class="badge ok badge-xs" title="Push унаследован от группы {{$pushG}}">Push: {{$pushG}}</span>
                  {{else}}
                    <span class="badge warn badge-xs" title="Push унаследован от группы {{$pushG}}, но Telegram не привязан">⚠️ Push: {{$pushG}} (нет ТГ)</span>
                  {{end}}
                {{end}}
              {{end}}
            </div>
            <div>
              {{if .VLAN}}
                <span class="badge info badge-xs" title="VLAN {{.VLAN}} задан индивидуально">VLAN: {{vlanDesc $.VLANProfiles .VLAN}}</span>
              {{else}}
                {{$gVlan := index $.InheritedVLAN .ID}}
                {{if $gVlan}}
                  <span class="badge info badge-xs" title="VLAN унаследован от группы {{index $.InheritedVLANGroup .ID}}">VLAN: {{vlanDesc $.VLANProfiles $gVlan}} <span class="dim">({{index $.InheritedVLANGroup .ID}})</span></span>
                {{end}}
              {{end}}
            </div>
          </div>
        </td>
        <td>
          <div class="users-actions-wrap">
            <a class="btn secondary sm" href="/admin/users/{{.ID}}">Редактировать</a>
            <div class="user-dropdown">
              <button type="button" class="btn secondary sm user-dropdown-toggle" title="Дополнительные действия">•••</button>
              <div class="user-dropdown-menu">
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="reset-totp">
                  <button type="submit" class="user-dropdown-item">
                    <span>🔑</span> <span>Сброс TOTP</span>
                  </button>
                </form>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="reset-webauthn">
                  <button type="submit" class="user-dropdown-item">
                    <span>🛡️</span> <span>Сброс passkeys</span>
                  </button>
                </form>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="unlink-telegram">
                  <button type="submit" class="user-dropdown-item">
                    <span>✈️</span> <span>Отвязать Telegram</span>
                  </button>
                </form>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="revoke-devices">
                  <button type="submit" class="user-dropdown-item">
                    <span>📱</span> <span>Отозвать устройства</span>
                  </button>
                </form>
                <div class="user-dropdown-divider"></div>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="delete">
                  <button type="submit" class="user-dropdown-item danger" data-confirm="Удалить пользователя {{.Username}}?">
                    <span>🗑️</span> <span>Удалить</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </td>
      </tr>
      {{end}}
      </tbody>
    </table>
    <div id="users-empty" class="users-empty-search is-hidden">
      Пользователи по заданным критериям не найдены
    </div>
  </div>

  <div class="users-pagination-bar" id="users-pagination">
    <div class="users-pagination-info" id="users-pagination-info">
      Показано 0 из 0
    </div>
    <div class="users-pagination-controls">
      <div class="per-page-control">
        <span>На странице:</span>
        <select id="users-per-page" class="select select-per-page">
          <option value="25" selected>25</option>
          <option value="50">50</option>
          <option value="100">100</option>
          <option value="all">Все</option>
        </select>
      </div>
      <div class="users-page-btns" id="users-page-btns">
      </div>
    </div>
  </div>
</section>

{{end}}

{{define "userFields"}}
<div class="field-row">
  <label class="field">
    <span class="field-label">Имя пользователя</span>
    <input class="input" type="text" name="username" value="{{if .Edit}}{{.Edit.Username}}{{end}}" required>
  </label>
  <label class="field">
    <span class="field-label">Пароль <span class="muted">(пусто — не менять)</span></span>
    <input class="input" type="password" name="password" autocomplete="new-password">
  </label>
</div>
<div class="field-row">
  <label class="field">
    <span class="field-label">Роль</span>
    <select class="select" name="role">
      <option value="user"{{if and .Edit (eq .Edit.Role "user")}} selected{{end}}>user</option>
      <option value="admin"{{if and .Edit (eq .Edit.Role "admin")}} selected{{end}}>admin</option>
    </select>
    <span class="help">admin видит раздел «Админ» и управляет настройками.</span>
  </label>
  <label class="field">
    <span class="field-label">Источник пароля</span>
    <select class="select" name="source">
      <option value="local"{{if or (not .Edit) (ne .Edit.Source "ldap")}} selected{{end}}>local — локальный пароль</option>
      <option value="ldap"{{if and .Edit (eq .Edit.Source "ldap")}} selected{{end}}>ldap — каталог LDAP/AD</option>
    </select>
    <span class="help">ldap: пароль проверяется bind-ом в каталоге, при
    первом входе учётка создаётся автоматически. При переводе LDAP→local
    задайте новый пароль — прежний локальный хеш непригоден.</span>
  </label>
  <div class="field">
    <span class="field-label">Доступ</span>
    <label class="check"><input type="checkbox" name="enabled" value="1"{{if or (not .Edit) .Edit.Enabled}} checked{{end}}> <span>Включён</span></label>
    <span class="help">Отключённый не может войти, его сессии моментально
    отзываются.</span>
  </div>
</div>
<div class="field-row">
  <label class="field">
    <span class="field-label">Email</span>
    <input class="input" type="email" name="email" value="{{if .Edit}}{{.Edit.Email}}{{end}}">
  </label>
  <label class="field">
    <span class="field-label">Телефон</span>
    <input class="input" type="tel" name="phone" value="{{if .Edit}}{{.Edit.Phone}}{{end}}" placeholder="+79990001122">
  </label>
</div>
<label class="field">
  <span class="field-label">Отображаемое имя</span>
  <input class="input" type="text" name="display_name" value="{{if .Edit}}{{.Edit.DisplayName}}{{end}}"
    {{if and .Edit (eq .Edit.Source "ldap")}}disabled title="Синхронизируется из каталога LDAP при каждом входе"{{end}}>
  {{if and .Edit (eq .Edit.Source "ldap")}}<span class="help">Синхронизируется из каталога при каждом входе LDAP-пользователя.</span>{{end}}
</label>
<div class="field">
  <span class="field-label">Специализация технической поддержки (SOS)</span>
  <div class="support-roles-row">
    {{if .SupportCategories}}
      {{range .SupportCategories}}
      <label class="check">
        <input type="checkbox" name="support_roles" value="{{.ID}}"{{if and $.Edit (hasStr $.Edit.SupportRoles .ID)}} checked{{end}}>
        <span>{{.Icon}} {{.Name}}</span>
      </label>
      {{end}}
    {{else}}
      <label class="check">
        <input type="checkbox" name="support_roles" value="it"{{if and .Edit (hasStr .Edit.SupportRoles "it")}} checked{{end}}>
        <span>🖥 Инженер IT-поддержки</span>
      </label>
      <label class="check">
        <input type="checkbox" name="support_roles" value="1c"{{if and .Edit (hasStr .Edit.SupportRoles "1c")}} checked{{end}}>
        <span>📊 Специалист по 1С</span>
      </label>
    {{end}}
  </div>
  <span class="help">Специалисты получают доступ к SOS-заявкам и могут подключаться к удаленным ПК пользователей прямо из приложения.</span>
</div>
<div class="field">
  <span class="field-label">Локальные группы</span>
  {{if .AllGroups}}
  <div class="select-grid select-grid-capped">
    {{range .AllGroups}}
    <label class="select-chip">
      <input type="checkbox" name="groups" value="{{.ID}}"{{if hasUUID $.EditGroupIDs .ID}} checked{{end}}>
      <div class="select-chip-label">
        <span>{{.Name}}</span>
        {{if .Description}}<span class="select-chip-sub">{{.Description}}</span>{{end}}
      </div>
    </label>
    {{end}}
  </div>
  {{else}}
  <span class="help">Локальные группы ещё не созданы. Создать их можно в разделе <a href="/admin/groups">«Группы»</a>.</span>
  {{end}}
</div>
{{if and .Edit .Edit.LDAPGroups}}
<div class="field">
  <span class="field-label">Группы LDAP/Active Directory</span>
  <div class="ldap-groups-badges">
    {{range .Edit.LDAPGroups}}<span class="badge neutral" title="{{.}}">{{groupCN .}}</span>{{end}}
  </div>
  <span class="help">Синхронизируются автоматически из каталога при входе пользователя.</span>
</div>
{{end}}
<fieldset class="check-group">
  <legend>Каналы второго фактора</legend>
  <label class="check"><input type="checkbox" name="prefer_channels" value="app_push"{{if and .Edit (hasChan .Edit.PreferChannels "app_push")}} checked{{end}}> <span>📱 Приложение Ligament (Push)</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="totp"{{if and .Edit (hasChan .Edit.PreferChannels "totp")}} checked{{end}}> <span>TOTP</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="telegram"{{if and .Edit (hasChan .Edit.PreferChannels "telegram")}} checked{{end}}> <span>Telegram</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="email"{{if and .Edit (hasChan .Edit.PreferChannels "email")}} checked{{end}}> <span>Email</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="sms"{{if and .Edit (hasChan .Edit.PreferChannels "sms")}} checked{{end}}> <span>SMS</span></label>
</fieldset>
<label class="check"><input type="checkbox" name="radius_push" value="1"{{if and .Edit .Edit.RadiusPush}} checked{{end}}> <span>RADIUS Push — Telegram-подтверждение вместо кода</span></label>
{{if and .Edit (not .Edit.TelegramLinked)}}
<div class="help help-warning">
  ⚠️ <b>Внимание:</b> Telegram ещё не привязан к этому аккаунту. Пока пользователь не привяжет бота (в личном кабинете <code>/me</code>) или не введёт TOTP-код слитно с паролем, подключение к Wi-Fi будет <b>заблокировано</b> сервером (защита от неавторизованного входа).
</div>
{{else if not .Edit}}
<div class="help help-note">
  ℹ️ Для нового пользователя потребуется привязать Telegram-бота в <code>/me</code> после первого входа, иначе вход по RADIUS Push будет требовать TOTP-код.
</div>
{{end}}
<div class="field field-mt">
  <span class="field-label">📶 Сетевой сегмент / VLAN (Wi-Fi)</span>
  <div class="vlan-row">
    <select class="select" id="user-vlan-select" data-vlan-input="user-vlan-input">
      <option value="">— По умолчанию (наследовать из группы / без VLAN) —</option>
      {{range $vid, $vname := $.VLANProfiles}}
        <option value="{{$vid}}"{{if and $.Edit (eq $.Edit.VLAN $vid)}} selected{{end}}>VLAN {{$vid}} — {{$vname}}</option>
      {{end}}
      <option value="custom"{{if and $.Edit $.Edit.VLAN (not (index $.VLANProfiles $.Edit.VLAN))}} selected{{end}}>Свой номер VLAN...</option>
    </select>
    <input class="input mono vlan-input" type="text" name="vlan_id" id="user-vlan-input" placeholder="VLAN ID" value="{{if .Edit}}{{.Edit.VLAN}}{{end}}">
  </div>
  {{if and .Edit $.EditInheritedVLAN (not .Edit.VLAN)}}
    <span class="help help-accent">💡 Сейчас унаследован от группы <b>{{$.EditInheritedGroup}}</b>: <b>{{vlanDesc $.VLANProfiles $.EditInheritedVLAN}}</b>. Укажите номер только если нужно переопределить сегмент персонально для этого пользователя.</span>
  {{else}}
    <span class="help">Автоматическая изоляция пользователя в указанный VLAN при подключении к корпоративному Wi-Fi или VPN (RFC 3580). Если не задан, наследуется из группы с наивысшим приоритетом.</span>
  {{end}}
</div>
<details class="advanced-details advanced-gap">
  <summary class="muted summary-toggle">⚙️ Дополнительные RADIUS-атрибуты (JSON)</summary>
  <label class="field field-mt-sm">
    <span class="field-label">RADIUS Reply <span class="muted">(JSON)</span></span>
    <textarea class="textarea mono" name="radius_reply" rows="3" placeholder='{"Mikrotik-Group": "vpn"}'>{{if .Edit}}{{.EditReplyJSON}}{{end}}</textarea>
    <div class="radius-presets radius-presets-bar">
      <span class="muted presets-label">Шаблоны:</span>
      <button type="button" class="btn small outline" data-radius-preset="mikrotik_std">⚡ MikroTik: 30M/50M</button>
      <button type="button" class="btn small outline" data-radius-preset="mikrotik_vip">⚡ MikroTik: 100M (VIP)</button>
      <button type="button" class="btn small outline" data-radius-preset="mikrotik_guest">⚡ MikroTik: 5M/10M</button>
      <button type="button" class="btn small outline" data-radius-preset="unifi_vlan20">🌐 UniFi: VLAN 20</button>
      <button type="button" class="btn small outline" data-radius-preset="unifi_vlan30">🌐 UniFi: VLAN 30</button>
      <button type="button" class="btn small outline" data-radius-preset="workday">⏱️ Смена 8ч + 1 сессия</button>
      <button type="button" class="btn small outline" data-radius-preset="vpn_pool">🛡️ VPN: Пул адресов</button>
    </div>
    <span class="help">Специальные атрибуты Access-Accept (скорость MikroTik-Rate-Limit, VLAN Tunnel-Private-Group-Id, тайм-ауты Session-Timeout, пулы Framed-Pool и др.).</span>
  </label>
</details>
<div class="form-actions">
  <button type="submit" class="btn primary">Сохранить</button>
</div>
{{end}}
