{{define "content"}}
<h1>Пользователи</h1>

<table>
  <tr>
    <th>Имя</th><th>Роль</th><th>Включён</th><th>Каналы</th><th>RADIUS Push</th><th>Действия</th>
  </tr>
  {{range .Users}}
  <tr{{if not .Enabled}} class="disabled"{{end}}>
    <td>{{.Username}}</td>
    <td><span class="badge {{if eq .Role "admin"}}ok{{end}}">{{.Role}}</span></td>
    <td>{{if .Enabled}}<span class="badge ok">да</span>{{else}}<span class="badge off">нет</span>{{end}}</td>
    <td>{{range .PreferChannels}}<span class="badge">{{.}}</span> {{end}}</td>
    <td>{{if .RadiusPush}}да{{else}}нет{{end}}</td>
    <td class="row-actions">
      <a href="/admin/users/{{.ID}}">Редактировать</a>
      <form action="/admin/users/{{.ID}}" method="post">{{csrf $.CSRF}}<input type="hidden" name="do" value="reset-totp">
        <button type="submit" class="secondary" title="Сбросить TOTP и перегенерировать резервные коды">Сброс TOTP</button>
      </form>
      <form action="/admin/users/{{.ID}}" method="post">{{csrf $.CSRF}}<input type="hidden" name="do" value="reset-webauthn">
        <button type="submit" class="secondary">Сброс passkeys</button>
      </form>
      <form action="/admin/users/{{.ID}}" method="post">{{csrf $.CSRF}}<input type="hidden" name="do" value="unlink-telegram">
        <button type="submit" class="secondary">Отвязать Telegram</button>
      </form>
      <form action="/admin/users/{{.ID}}" method="post">{{csrf $.CSRF}}<input type="hidden" name="do" value="revoke-devices">
        <button type="submit" class="secondary">Отозвать устройства</button>
      </form>
      <form action="/admin/users/{{.ID}}" method="post">{{csrf $.CSRF}}<input type="hidden" name="do" value="delete">
        <button type="submit" class="danger" onclick="return confirm('Удалить пользователя {{.Username}}?')">Удалить</button>
      </form>
    </td>
  </tr>
  {{end}}
</table>

{{if .Edit}}
<h2>Редактирование: {{.Edit.Username}}</h2>
<form action="/admin/users/{{.Edit.ID}}" method="post" class="wide">
  {{csrf .CSRF}}
  <input type="hidden" name="do" value="save">
  {{template "userFields" .}}
</form>
{{else}}
<h2>Новый пользователь</h2>
<form action="/admin/users" method="post" class="wide">
  {{csrf .CSRF}}
  {{template "userFields" .}}
</form>
{{end}}
{{end}}

{{define "userFields"}}
<div class="grid">
  <label>Имя пользователя
    <input type="text" name="username" value="{{if .Edit}}{{.Edit.Username}}{{end}}" required>
  </label>
  <label>Пароль <span class="muted">(пусто — не менять)</span>
    <input type="password" name="password" autocomplete="new-password">
  </label>
  <label>Роль
    <select name="role">
      <option value="user"{{if and .Edit (eq .Edit.Role "user")}} selected{{end}}>user</option>
      <option value="admin"{{if and .Edit (eq .Edit.Role "admin")}} selected{{end}}>admin</option>
    </select>
  </label>
  <label class="check"><input type="checkbox" name="enabled" value="1"{{if or (not .Edit) .Edit.Enabled}} checked{{end}}> Включён</label>
  <label>Email
    <input type="email" name="email" value="{{if .Edit}}{{.Edit.Email}}{{end}}">
  </label>
  <label>Телефон
    <input type="tel" name="phone" value="{{if .Edit}}{{.Edit.Phone}}{{end}}">
  </label>
</div>
<fieldset>
  <legend>Каналы второго фактора</legend>
  <label class="check"><input type="checkbox" name="prefer_channels" value="totp"{{if and .Edit (hasChan .Edit.PreferChannels "totp")}} checked{{end}}> TOTP</label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="telegram"{{if and .Edit (hasChan .Edit.PreferChannels "telegram")}} checked{{end}}> Telegram</label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="email"{{if and .Edit (hasChan .Edit.PreferChannels "email")}} checked{{end}}> Email</label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="sms"{{if and .Edit (hasChan .Edit.PreferChannels "sms")}} checked{{end}}> SMS</label>
</fieldset>
<label class="check"><input type="checkbox" name="radius_push" value="1"{{if and .Edit .Edit.RadiusPush}} checked{{end}}> RADIUS Push (Telegram-подтверждение вместо кода)</label>
<label>RADIUS Reply (JSON, атрибуты Access-Accept для этого пользователя)
  <textarea name="radius_reply" rows="4" placeholder='{"Mikrotik-Group": "vpn"}'>{{if .Edit}}{{.EditReplyJSON}}{{end}}</textarea>
</label>
<button type="submit">Сохранить</button>
{{end}}
