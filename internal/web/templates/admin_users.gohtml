{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Пользователи</h1>
  <p class="page-sub">Все учётные записи сервера: роли, каналы кодов и
  чувствительные действия.</p>
</header>

{{if .BackupCodes}}
<section class="card">
  <div class="card-head">
    <h2>Новые резервные коды</h2>
    <p>Выданы после сброса TOTP — передайте их пользователю безопасным
    способом.</p>
  </div>
  <div class="flash err"><span class="flash-icon">⚠️</span>Показываются только один раз — сохраните!</div>
  <ul class="codes">
    {{range .BackupCodes}}<li><code>{{.}}</code></li>{{end}}
  </ul>
</section>
{{end}}

<section class="card">
  <div class="card-head">
    <h2>Список</h2>
    <p>Действия применяются сразу; удаление необратимо.</p>
  </div>
  <div class="table-wrap">
    <table class="table">
      <tr>
        <th>Имя</th><th>Источник</th><th>Роль</th><th>Включён</th><th>Каналы</th><th>VLAN (Wi-Fi)</th><th>RADIUS Push</th><th>Действия</th>
      </tr>
      {{range .Users}}
      <tr{{if not .Enabled}} class="row-off"{{end}}>
        <td class="cell-strong">{{.Username}}{{if .DisplayName}} <span class="muted">({{.DisplayName}})</span>{{end}}</td>
        <td>{{if eq .Source "ldap"}}<span class="badge warn">ldap</span>{{else}}<span class="badge neutral">local</span>{{end}}</td>
        <td><span class="badge {{if eq .Role "admin"}}ok{{else}}neutral{{end}}">{{.Role}}</span></td>
        <td>{{if .Enabled}}<span class="badge ok">да</span>{{else}}<span class="badge err">нет</span>{{end}}</td>
        <td>{{range .PreferChannels}}<span class="badge neutral">{{.}}</span> {{end}}</td>
        <td>{{if .VLAN}}<span class="badge info" title="Сетевой сегмент: Tunnel-Private-Group-Id {{.VLAN}}">{{vlanDesc $.VLANProfiles .VLAN}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
        <td>{{if .RadiusPush}}<span class="badge ok">да</span>{{else}}<span class="badge neutral">нет</span>{{end}}</td>
        <td class="row-actions">
          <a class="btn secondary sm" href="/admin/users/{{.ID}}">Редактировать</a>
          <form action="/admin/users/{{.ID}}" method="post" class="form-inline">{{csrf $.CSRF}}<input type="hidden" name="do" value="reset-totp">
            <button type="submit" class="btn secondary sm" title="Сбросить TOTP и перегенерировать резервные коды">Сброс TOTP</button>
          </form>
          <form action="/admin/users/{{.ID}}" method="post" class="form-inline">{{csrf $.CSRF}}<input type="hidden" name="do" value="reset-webauthn">
            <button type="submit" class="btn secondary sm">Сброс passkeys</button>
          </form>
          <form action="/admin/users/{{.ID}}" method="post" class="form-inline">{{csrf $.CSRF}}<input type="hidden" name="do" value="unlink-telegram">
            <button type="submit" class="btn secondary sm">Отвязать Telegram</button>
          </form>
          <form action="/admin/users/{{.ID}}" method="post" class="form-inline">{{csrf $.CSRF}}<input type="hidden" name="do" value="revoke-devices">
            <button type="submit" class="btn secondary sm">Отозвать устройства</button>
          </form>
          <form action="/admin/users/{{.ID}}" method="post" class="form-inline">{{csrf $.CSRF}}<input type="hidden" name="do" value="delete">
            <button type="submit" class="btn danger sm" data-confirm="Удалить пользователя {{.Username}}?">Удалить</button>
          </form>
        </td>
      </tr>
      {{end}}
    </table>
  </div>
</section>

{{if .Edit}}
<section class="card">
  <div class="card-head">
    <h2>Редактирование: {{.Edit.Username}}</h2>
    <p>Пустой пароль — оставить текущий.</p>
  </div>
  <form action="/admin/users/{{.Edit.ID}}" method="post" class="form wide">
    {{csrf .CSRF}}
    <input type="hidden" name="do" value="save">
    {{template "userFields" .}}
  </form>
</section>
{{else}}
<section class="card">
  <div class="card-head">
    <h2>Новый пользователь</h2>
    <p>Имя и пароль обязательны; остальное можно изменить позже.</p>
  </div>
  <form action="/admin/users" method="post" class="form wide">
    {{csrf .CSRF}}
    {{template "userFields" .}}
  </form>
</section>
{{end}}
{{end}}

{{define "userFields"}}
<div class="field-row">
  <label class="field">
    <span class="field-label">Имя пользователя</span>
    <input class="input" type="text" name="username" value="{{if .Edit}}{{.Edit.Username}}{{end}}" required>
  </label>
  <label class="field">
    <span class="field-label">Пароль <span class="muted">(пусто — не менять)</span></span>
    <input class="input" type="password" name="password" autocomplete="new-password">
  </label>
</div>
<div class="field-row">
  <label class="field">
    <span class="field-label">Роль</span>
    <select class="select" name="role">
      <option value="user"{{if and .Edit (eq .Edit.Role "user")}} selected{{end}}>user</option>
      <option value="admin"{{if and .Edit (eq .Edit.Role "admin")}} selected{{end}}>admin</option>
    </select>
    <span class="help">admin видит раздел «Админ» и управляет настройками.</span>
  </label>
  <label class="field">
    <span class="field-label">Источник пароля</span>
    <select class="select" name="source">
      <option value="local"{{if or (not .Edit) (ne .Edit.Source "ldap")}} selected{{end}}>local — локальный пароль</option>
      <option value="ldap"{{if and .Edit (eq .Edit.Source "ldap")}} selected{{end}}>ldap — каталог LDAP/AD</option>
    </select>
    <span class="help">ldap: пароль проверяется bind-ом в каталоге, при
    первом входе учётка создаётся автоматически. При переводе LDAP→local
    задайте новый пароль — прежний локальный хеш непригоден.</span>
  </label>
  <div class="field">
    <span class="field-label">Доступ</span>
    <label class="check"><input type="checkbox" name="enabled" value="1"{{if or (not .Edit) .Edit.Enabled}} checked{{end}}> <span>Включён</span></label>
    <span class="help">Отключённый не может войти, его сессии моментально
    отзываются.</span>
  </div>
</div>
<div class="field-row">
  <label class="field">
    <span class="field-label">Email</span>
    <input class="input" type="email" name="email" value="{{if .Edit}}{{.Edit.Email}}{{end}}">
  </label>
  <label class="field">
    <span class="field-label">Телефон</span>
    <input class="input" type="tel" name="phone" value="{{if .Edit}}{{.Edit.Phone}}{{end}}" placeholder="+79990001122">
  </label>
</div>
<label class="field">
  <span class="field-label">Отображаемое имя</span>
  <input class="input" type="text" name="display_name" value="{{if .Edit}}{{.Edit.DisplayName}}{{end}}"
    {{if and .Edit (eq .Edit.Source "ldap")}}disabled title="Синхронизируется из каталога LDAP при каждом входе"{{end}}>
  {{if and .Edit (eq .Edit.Source "ldap")}}<span class="help">Синхронизируется из каталога при каждом входе LDAP-пользователя.</span>{{end}}
</label>
<fieldset class="check-group">
  <legend>Каналы второго фактора</legend>
  <label class="check"><input type="checkbox" name="prefer_channels" value="totp"{{if and .Edit (hasChan .Edit.PreferChannels "totp")}} checked{{end}}> <span>TOTP</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="telegram"{{if and .Edit (hasChan .Edit.PreferChannels "telegram")}} checked{{end}}> <span>Telegram</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="email"{{if and .Edit (hasChan .Edit.PreferChannels "email")}} checked{{end}}> <span>Email</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="sms"{{if and .Edit (hasChan .Edit.PreferChannels "sms")}} checked{{end}}> <span>SMS</span></label>
</fieldset>
<label class="check"><input type="checkbox" name="radius_push" value="1"{{if and .Edit .Edit.RadiusPush}} checked{{end}}> <span>RADIUS Push — Telegram-подтверждение вместо кода</span></label>
<div class="field" style="margin-top: 0.5rem;">
  <span class="field-label">📶 Сетевой сегмент / VLAN (Wi-Fi)</span>
  <div style="display: flex; gap: 8px; align-items: center; max-width: 500px;">
    <select class="select" id="user-vlan-select" onchange="var inp=document.getElementById('user-vlan-input'); if(this.value!=='custom'){ inp.value=this.value; } else { inp.focus(); }">
      <option value="">— По умолчанию (без персонального VLAN) —</option>
      {{range $vid, $vname := $.VLANProfiles}}
        <option value="{{$vid}}"{{if and $.Edit (eq $.Edit.VLAN $vid)}} selected{{end}}>VLAN {{$vid}} — {{$vname}}</option>
      {{end}}
      <option value="custom"{{if and $.Edit $.Edit.VLAN (not (index $.VLANProfiles $.Edit.VLAN))}} selected{{end}}>Свой номер VLAN...</option>
    </select>
    <input class="input mono" type="text" name="vlan_id" id="user-vlan-input" style="max-width: 130px;" placeholder="VLAN ID" value="{{if .Edit}}{{.Edit.VLAN}}{{end}}">
  </div>
  <span class="help">Автоматическая изоляция пользователя в указанный VLAN при подключении к корпоративному Wi-Fi или VPN (RFC 3580).</span>
</div>
<details class="advanced-details" style="margin: 8px 0 16px;">
  <summary class="muted" style="cursor: pointer; font-size: 0.9rem; user-select: none;">⚙️ Дополнительные RADIUS-атрибуты (JSON)</summary>
  <label class="field" style="margin-top: 8px;">
    <span class="field-label">RADIUS Reply <span class="muted">(JSON)</span></span>
    <textarea class="textarea mono" name="radius_reply" rows="3" placeholder='{"Mikrotik-Group": "vpn"}'>{{if .Edit}}{{.EditReplyJSON}}{{end}}</textarea>
    <span class="help">Специальные атрибуты Access-Accept (Mikrotik-Group, Filter-Id, Framed-Pool и др.). VLAN можно задать в поле выше или здесь.</span>
  </label>
</details>
<div class="form-actions">
  <button type="submit" class="btn primary">Сохранить</button>
</div>
{{end}}
