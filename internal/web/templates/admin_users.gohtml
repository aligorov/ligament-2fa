{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Пользователи</h1>
  <p class="page-sub">Все учётные записи сервера: роли, каналы кодов и
  чувствительные действия.</p>
</header>

{{if .BackupCodes}}
<section class="card">
  <div class="card-head">
    <h2>Новые резервные коды</h2>
    <p>Выданы после сброса TOTP — передайте их пользователю безопасным
    способом.</p>
  </div>
  <div class="flash err"><span class="flash-icon">⚠️</span>Показываются только один раз — сохраните!</div>
  <ul class="codes">
    {{range .BackupCodes}}<li><code>{{.}}</code></li>{{end}}
  </ul>
</section>
{{end}}

<section class="card">
  <div class="card-head users-card-head">
    <div>
      <h2>Список</h2>
      <p>Действия применяются сразу; удаление необратимо.</p>
    </div>
    <div>
      <a href="#new-user" class="btn primary sm">➕ Новый пользователь</a>
    </div>
  </div>

  <div class="users-toolbar">
    <div class="users-search-box">
      <span class="search-icon">🔍</span>
      <input type="text" id="users-search" class="input" placeholder="Поиск по имени, логину, почте, телефону или группе..." autocomplete="off">
      <button type="button" id="users-search-clear" class="search-clear" style="display: none;" title="Очистить">&times;</button>
    </div>
    <div class="users-filter-pills" id="users-filter-pills">
      <button type="button" class="users-pill active" data-filter="all">Все <span class="count" id="count-all">0</span></button>
      <button type="button" class="users-pill" data-filter="ldap">🏢 LDAP <span class="count" id="count-ldap">0</span></button>
      <button type="button" class="users-pill" data-filter="local">🔑 Локальные <span class="count" id="count-local">0</span></button>
      <button type="button" class="users-pill" data-filter="admin">🛡️ Админы <span class="count" id="count-admin">0</span></button>
      <button type="button" class="users-pill" data-filter="disabled">⚠️ Отключённые <span class="count" id="count-disabled">0</span></button>
    </div>
  </div>

  <div class="table-wrap">
    <table class="table users-table" id="users-table">
      <thead>
        <tr>
          <th>Пользователь</th>
          <th>Источник / Статус</th>
          <th>Группы</th>
          <th>2FA & Сеть</th>
          <th style="text-align: right;">Действия</th>
        </tr>
      </thead>
      <tbody>
      {{range .Users}}
      {{$ug := index $.UserGroups .ID}}
      <tr class="user-row{{if not .Enabled}} row-off{{end}}"
          data-username="{{.Username}}"
          data-name="{{.DisplayName}}"
          data-email="{{.Email}}"
          data-phone="{{.Phone}}"
          data-source="{{.Source}}"
          data-role="{{.Role}}"
          data-enabled="{{if .Enabled}}1{{else}}0{{end}}"
          data-groups="{{range $ug}}{{.}} {{end}}{{range .LDAPGroups}}{{groupCN .}} {{.}}{{end}}">
        <td>
          <div class="user-profile-cell">
            <div class="user-avatar" style="background-color: {{userAvatarBg .Username}};">
              {{userInitials .DisplayName .Username}}
            </div>
            <div class="user-names">
              <div class="user-primary-name">
                <a class="user-name-link" href="/admin/users/{{.ID}}">
                  {{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}
                </a>
                {{if and .DisplayName (ne .DisplayName .Username)}}
                  <span class="muted" style="font-size: 0.8rem; font-weight: normal;">@{{.Username}}</span>
                {{end}}
              </div>
              <div class="user-secondary-name">
                {{if .Email}}<span>✉️ {{.Email}}</span>{{end}}
                {{if and .Email .Phone}}<span class="dot-sep">•</span>{{end}}
                {{if .Phone}}<span>📱 {{.Phone}}</span>{{end}}
                {{if and (not .Email) (not .Phone)}}
                  <span class="muted">ID: {{printf "%.8s" .ID}}</span>
                {{end}}
              </div>
            </div>
          </div>
        </td>
        <td>
          <div style="display: flex; flex-direction: column; gap: 4px; align-items: flex-start;">
            <div style="display: flex; gap: 4px; align-items: center;">
              {{if eq .Source "ldap"}}
                <span class="badge warn" title="Синхронизирован из Active Directory / LDAP">ldap</span>
              {{else}}
                <span class="badge neutral" title="Локальная учётная запись сервера">local</span>
              {{end}}
              <span class="badge {{if eq .Role "admin"}}ok{{else}}neutral{{end}}">{{.Role}}</span>
            </div>
            <div>
              {{if .Enabled}}
                <span class="badge ok" style="font-size: 0.72rem;">активен</span>
              {{else}}
                <span class="badge err" style="font-size: 0.72rem;">отключён</span>
              {{end}}
            </div>
          </div>
        </td>
        <td>
          <div class="user-groups-cell">
            {{if $ug}}
              {{range $ug}}<span class="badge info" title="Локальная группа">{{.}}</span>{{end}}
            {{end}}
            {{if .LDAPGroups}}
              {{$ldapLen := len .LDAPGroups}}
              {{if le $ldapLen 3}}
                {{range .LDAPGroups}}
                  <span class="badge neutral" title="LDAP DN: {{.}}">{{groupCN .}}</span>
                {{end}}
              {{else}}
                {{range $i, $g := .LDAPGroups}}
                  {{if lt $i 2}}
                    <span class="badge neutral" title="LDAP DN: {{$g}}">{{groupCN $g}}</span>
                  {{end}}
                {{end}}
                <span class="badge neutral" style="cursor: help;" title="{{range .LDAPGroups}}{{.}}&#10;{{end}}">+{{sub $ldapLen 2}} ещё</span>
              {{end}}
            {{end}}
            {{if and (not $ug) (not .LDAPGroups)}}
              <span class="muted" style="font-size: 0.8rem;">—</span>
            {{end}}
          </div>
        </td>
        <td>
          <div style="display: flex; flex-direction: column; gap: 4px; font-size: 0.8rem;">
            <div style="display: flex; gap: 4px; align-items: center; flex-wrap: wrap;">
              {{if .PreferChannels}}
                {{range .PreferChannels}}<span class="badge neutral" style="font-size: 0.72rem;">{{.}}</span>{{end}}
              {{else}}
                <span class="muted" style="font-size: 0.75rem;" title="Каналы не настроены">2FA: —</span>
              {{end}}
              {{if .RadiusPush}}
                {{if .TelegramLinked}}
                  <span class="badge ok" style="font-size: 0.72rem;" title="RADIUS Push включен в профиле">Push: да</span>
                {{else}}
                  <span class="badge warn" style="font-size: 0.72rem;" title="Push включен, но Telegram не привязан">⚠️ Push (нет ТГ)</span>
                {{end}}
              {{else}}
                {{$pushG := index $.InheritedPushGroup .ID}}
                {{if $pushG}}
                  {{if .TelegramLinked}}
                    <span class="badge ok" style="font-size: 0.72rem;" title="Push унаследован от группы {{$pushG}}">Push: {{$pushG}}</span>
                  {{else}}
                    <span class="badge warn" style="font-size: 0.72rem;" title="Push унаследован от группы {{$pushG}}, но Telegram не привязан">⚠️ Push: {{$pushG}} (нет ТГ)</span>
                  {{end}}
                {{end}}
              {{end}}
            </div>
            <div>
              {{if .VLAN}}
                <span class="badge info" style="font-size: 0.72rem;" title="VLAN {{.VLAN}} задан индивидуально">VLAN: {{vlanDesc $.VLANProfiles .VLAN}}</span>
              {{else}}
                {{$gVlan := index $.InheritedVLAN .ID}}
                {{if $gVlan}}
                  <span class="badge info" style="font-size: 0.72rem;" title="VLAN унаследован от группы {{index $.InheritedVLANGroup .ID}}">VLAN: {{vlanDesc $.VLANProfiles $gVlan}} <span style="opacity: 0.8;">({{index $.InheritedVLANGroup .ID}})</span></span>
                {{end}}
              {{end}}
            </div>
          </div>
        </td>
        <td>
          <div class="users-actions-wrap">
            <a class="btn secondary sm" href="/admin/users/{{.ID}}">Редактировать</a>
            <div class="user-dropdown">
              <button type="button" class="btn secondary sm user-dropdown-toggle" title="Дополнительные действия">•••</button>
              <div class="user-dropdown-menu">
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="reset-totp">
                  <button type="submit" class="user-dropdown-item">
                    <span>🔑</span> <span>Сброс TOTP</span>
                  </button>
                </form>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="reset-webauthn">
                  <button type="submit" class="user-dropdown-item">
                    <span>🛡️</span> <span>Сброс passkeys</span>
                  </button>
                </form>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="unlink-telegram">
                  <button type="submit" class="user-dropdown-item">
                    <span>✈️</span> <span>Отвязать Telegram</span>
                  </button>
                </form>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="revoke-devices">
                  <button type="submit" class="user-dropdown-item">
                    <span>📱</span> <span>Отозвать устройства</span>
                  </button>
                </form>
                <div class="user-dropdown-divider"></div>
                <form action="/admin/users/{{.ID}}" method="post">
                  {{csrf $.CSRF}}
                  <input type="hidden" name="do" value="delete">
                  <button type="submit" class="user-dropdown-item danger" data-confirm="Удалить пользователя {{.Username}}?">
                    <span>🗑️</span> <span>Удалить</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </td>
      </tr>
      {{end}}
      </tbody>
    </table>
    <div id="users-empty" class="users-empty-search" style="display: none;">
      Пользователи по заданным критериям не найдены
    </div>
  </div>

  <div class="users-pagination-bar" id="users-pagination">
    <div class="users-pagination-info" id="users-pagination-info">
      Показано 0 из 0
    </div>
    <div class="users-pagination-controls">
      <div style="display: flex; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--muted);">
        <span>На странице:</span>
        <select id="users-per-page" class="select" style="padding: 0.25rem 0.5rem; font-size: 0.82rem; height: auto;">
          <option value="25" selected>25</option>
          <option value="50">50</option>
          <option value="100">100</option>
          <option value="all">Все</option>
        </select>
      </div>
      <div class="users-page-btns" id="users-page-btns">
      </div>
    </div>
  </div>
</section>

{{if .Edit}}
<section class="card">
  <div class="card-head">
    <h2>Редактирование: {{.Edit.Username}}</h2>
    <p>Пустой пароль — оставить текущий.</p>
  </div>
  <form action="/admin/users/{{.Edit.ID}}" method="post" class="form wide">
    {{csrf .CSRF}}
    <input type="hidden" name="do" value="save">
    {{template "userFields" .}}
  </form>
</section>
{{else}}
<section class="card" id="new-user">
  <div class="card-head">
    <h2>Новый пользователь</h2>
    <p>Имя и пароль обязательны; остальное можно изменить позже.</p>
  </div>
  <form action="/admin/users" method="post" class="form wide">
    {{csrf .CSRF}}
    {{template "userFields" .}}
  </form>
</section>
{{end}}
{{end}}

{{define "userFields"}}
<div class="field-row">
  <label class="field">
    <span class="field-label">Имя пользователя</span>
    <input class="input" type="text" name="username" value="{{if .Edit}}{{.Edit.Username}}{{end}}" required>
  </label>
  <label class="field">
    <span class="field-label">Пароль <span class="muted">(пусто — не менять)</span></span>
    <input class="input" type="password" name="password" autocomplete="new-password">
  </label>
</div>
<div class="field-row">
  <label class="field">
    <span class="field-label">Роль</span>
    <select class="select" name="role">
      <option value="user"{{if and .Edit (eq .Edit.Role "user")}} selected{{end}}>user</option>
      <option value="admin"{{if and .Edit (eq .Edit.Role "admin")}} selected{{end}}>admin</option>
    </select>
    <span class="help">admin видит раздел «Админ» и управляет настройками.</span>
  </label>
  <label class="field">
    <span class="field-label">Источник пароля</span>
    <select class="select" name="source">
      <option value="local"{{if or (not .Edit) (ne .Edit.Source "ldap")}} selected{{end}}>local — локальный пароль</option>
      <option value="ldap"{{if and .Edit (eq .Edit.Source "ldap")}} selected{{end}}>ldap — каталог LDAP/AD</option>
    </select>
    <span class="help">ldap: пароль проверяется bind-ом в каталоге, при
    первом входе учётка создаётся автоматически. При переводе LDAP→local
    задайте новый пароль — прежний локальный хеш непригоден.</span>
  </label>
  <div class="field">
    <span class="field-label">Доступ</span>
    <label class="check"><input type="checkbox" name="enabled" value="1"{{if or (not .Edit) .Edit.Enabled}} checked{{end}}> <span>Включён</span></label>
    <span class="help">Отключённый не может войти, его сессии моментально
    отзываются.</span>
  </div>
</div>
<div class="field-row">
  <label class="field">
    <span class="field-label">Email</span>
    <input class="input" type="email" name="email" value="{{if .Edit}}{{.Edit.Email}}{{end}}">
  </label>
  <label class="field">
    <span class="field-label">Телефон</span>
    <input class="input" type="tel" name="phone" value="{{if .Edit}}{{.Edit.Phone}}{{end}}" placeholder="+79990001122">
  </label>
</div>
<label class="field">
  <span class="field-label">Отображаемое имя</span>
  <input class="input" type="text" name="display_name" value="{{if .Edit}}{{.Edit.DisplayName}}{{end}}"
    {{if and .Edit (eq .Edit.Source "ldap")}}disabled title="Синхронизируется из каталога LDAP при каждом входе"{{end}}>
  {{if and .Edit (eq .Edit.Source "ldap")}}<span class="help">Синхронизируется из каталога при каждом входе LDAP-пользователя.</span>{{end}}
</label>
<div class="field">
  <span class="field-label">Локальные группы</span>
  {{if .AllGroups}}
  <div class="select-grid" style="max-height: 140px;">
    {{range .AllGroups}}
    <label class="select-chip">
      <input type="checkbox" name="groups" value="{{.ID}}"{{if hasUUID $.EditGroupIDs .ID}} checked{{end}}>
      <div class="select-chip-label">
        <span>{{.Name}}</span>
        {{if .Description}}<span class="select-chip-sub">{{.Description}}</span>{{end}}
      </div>
    </label>
    {{end}}
  </div>
  {{else}}
  <span class="help">Локальные группы ещё не созданы. Создать их можно в разделе <a href="/admin/groups">«Группы»</a>.</span>
  {{end}}
</div>
{{if and .Edit .Edit.LDAPGroups}}
<div class="field">
  <span class="field-label">Группы LDAP/Active Directory</span>
  <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:4px;">
    {{range .Edit.LDAPGroups}}<span class="badge neutral">{{.}}</span>{{end}}
  </div>
  <span class="help">Синхронизируются автоматически из каталога при входе пользователя.</span>
</div>
{{end}}
<fieldset class="check-group">
  <legend>Каналы второго фактора</legend>
  <label class="check"><input type="checkbox" name="prefer_channels" value="totp"{{if and .Edit (hasChan .Edit.PreferChannels "totp")}} checked{{end}}> <span>TOTP</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="telegram"{{if and .Edit (hasChan .Edit.PreferChannels "telegram")}} checked{{end}}> <span>Telegram</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="email"{{if and .Edit (hasChan .Edit.PreferChannels "email")}} checked{{end}}> <span>Email</span></label>
  <label class="check"><input type="checkbox" name="prefer_channels" value="sms"{{if and .Edit (hasChan .Edit.PreferChannels "sms")}} checked{{end}}> <span>SMS</span></label>
</fieldset>
<label class="check"><input type="checkbox" name="radius_push" value="1"{{if and .Edit .Edit.RadiusPush}} checked{{end}}> <span>RADIUS Push — Telegram-подтверждение вместо кода</span></label>
{{if and .Edit (not .Edit.TelegramLinked)}}
<div class="help" style="color: #f59e0b; margin: 4px 0 8px 24px; font-size: 0.85rem;">
  ⚠️ <b>Внимание:</b> Telegram ещё не привязан к этому аккаунту. Пока пользователь не привяжет бота (в личном кабинете <code>/me</code>) или не введёт TOTP-код слитно с паролем, подключение к Wi-Fi будет <b>заблокировано</b> сервером (защита от неавторизованного входа).
</div>
{{else if not .Edit}}
<div class="help" style="color: var(--muted); margin: 4px 0 8px 24px; font-size: 0.85rem;">
  ℹ️ Для нового пользователя потребуется привязать Telegram-бота в <code>/me</code> после первого входа, иначе вход по RADIUS Push будет требовать TOTP-код.
</div>
{{end}}
<div class="field" style="margin-top: 0.5rem;">
  <span class="field-label">📶 Сетевой сегмент / VLAN (Wi-Fi)</span>
  <div style="display: flex; gap: 8px; align-items: center; max-width: 500px;">
    <select class="select" id="user-vlan-select" onchange="var inp=document.getElementById('user-vlan-input'); if(this.value!=='custom'){ inp.value=this.value; } else { inp.focus(); }">
      <option value="">— По умолчанию (наследовать из группы / без VLAN) —</option>
      {{range $vid, $vname := $.VLANProfiles}}
        <option value="{{$vid}}"{{if and $.Edit (eq $.Edit.VLAN $vid)}} selected{{end}}>VLAN {{$vid}} — {{$vname}}</option>
      {{end}}
      <option value="custom"{{if and $.Edit $.Edit.VLAN (not (index $.VLANProfiles $.Edit.VLAN))}} selected{{end}}>Свой номер VLAN...</option>
    </select>
    <input class="input mono" type="text" name="vlan_id" id="user-vlan-input" style="max-width: 130px;" placeholder="VLAN ID" value="{{if .Edit}}{{.Edit.VLAN}}{{end}}">
  </div>
  {{if and .Edit $.EditInheritedVLAN (not .Edit.VLAN)}}
    <span class="help" style="color: var(--accent); font-weight: 500;">💡 Сейчас унаследован от группы <b>{{$.EditInheritedGroup}}</b>: <b>{{vlanDesc $.VLANProfiles $.EditInheritedVLAN}}</b>. Укажите номер только если нужно переопределить сегмент персонально для этого пользователя.</span>
  {{else}}
    <span class="help">Автоматическая изоляция пользователя в указанный VLAN при подключении к корпоративному Wi-Fi или VPN (RFC 3580). Если не задан, наследуется из группы с наивысшим приоритетом.</span>
  {{end}}
</div>
<details class="advanced-details" style="margin: 8px 0 16px;">
  <summary class="muted" style="cursor: pointer; font-size: 0.9rem; user-select: none;">⚙️ Дополнительные RADIUS-атрибуты (JSON)</summary>
  <label class="field" style="margin-top: 8px;">
    <span class="field-label">RADIUS Reply <span class="muted">(JSON)</span></span>
    <textarea class="textarea mono" name="radius_reply" rows="3" placeholder='{"Mikrotik-Group": "vpn"}'>{{if .Edit}}{{.EditReplyJSON}}{{end}}</textarea>
    <span class="help">Специальные атрибуты Access-Accept (Mikrotik-Group, Filter-Id, Framed-Pool и др.). VLAN можно задать в поле выше или здесь.</span>
  </label>
</details>
<div class="form-actions">
  <button type="submit" class="btn primary">Сохранить</button>
</div>
{{end}}
