{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<div class="page-head">
  <div class="page-title-row">
    <div>
      <h1 class="page-title">🛟 Удаленная помощь (SOS)</h1>
      <p class="page-sub">Очередь экстренных обращений сотрудников компании за помощью и удаленное подключение к рабочим местам.</p>
    </div>
    <div class="support-header-actions">
      <button type="button" class="btn ghost sm" id="btn-toggle-sound" title="Включить звуковой сигнал при появлении новых заявок">
        🔔 Звук: Выкл
      </button>
      <button type="button" class="btn secondary sm" id="btn-open-support-settings">
        ⚙️ Категории и пороги
      </button>
      <form action="/admin/support" method="post" class="inline-form">
        {{csrf .CSRF}}
        <input type="hidden" name="action" value="cleanup">
        <button type="submit" class="btn ghost sm danger" data-confirm="Удалить все завершенные, отклоненные и отмененные обращения?">
          🧹 Очистить завершенные
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Верхняя сводка (KPI-счетчики) -->
<div class="support-kpi-grid">
  <a class="card support-kpi-card {{if eq .StatusFilter "requested"}}active{{end}}" href="/admin/support?status=requested{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val {{if gt .WaitingCount 0}}pulse-warn{{end}}">
      {{.WaitingCount}}
    </div>
    <div class="support-kpi-label">
      🟡 Ожидают инженера
    </div>
  </a>

  <a class="card support-kpi-card {{if eq .StatusFilter "connecting"}}active{{end}}" href="/admin/support?status=connecting{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val kpi-connecting">
      {{.ConnectingCount}}
    </div>
    <div class="support-kpi-label">
      🔵 2FA Авторизация
    </div>
  </a>

  <a class="card support-kpi-card {{if eq .StatusFilter "active"}}active{{end}}" href="/admin/support?status=active{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val kpi-active">
      {{.ActiveCount}}
    </div>
    <div class="support-kpi-label">
      🟢 В процессе
    </div>
  </a>

  <a class="card support-kpi-card {{if eq .StatusFilter "closed"}}active{{end}}" href="/admin/support?status=closed{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val kpi-closed">
      {{.ClosedCount}}
    </div>
    <div class="support-kpi-label">
      ⚪ Завершено
    </div>
  </a>
</div>

<!-- Фильтры по категориям и статусам -->
<div class="support-toolbar-row">
  <div class="support-filters-group">
    <a class="btn {{if or (eq .CategoryFilter "") (eq .CategoryFilter "all")}}primary{{else}}ghost{{end}} sm" href="/admin/support?category=all{{if .StatusFilter}}&status={{.StatusFilter}}{{end}}">
      Все категории
    </a>
    {{range .Categories}}
    <a class="btn {{if eq $.CategoryFilter .ID}}primary{{else}}ghost{{end}} sm" href="/admin/support?category={{.ID}}{{if $.StatusFilter}}&status={{$.StatusFilter}}{{end}}">
      {{.Icon}} {{.Name}}
    </a>
    {{end}}
  </div>

  <div class="support-filters-group">
    <span class="muted support-filter-label">Статус:</span>
    <a class="btn {{if or (eq .StatusFilter "") (eq .StatusFilter "all")}}secondary{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=all">
      Все
    </a>
    <a class="btn {{if eq .StatusFilter "requested"}}warn{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=requested">
      Ожидают {{if .WaitingCount}}<span class="badge warn sm badge-spaced">{{.WaitingCount}}</span>{{end}}
    </a>
    <a class="btn {{if eq .StatusFilter "active"}}ok{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=active">
      Активные {{if .ActiveCount}}<span class="badge ok sm badge-spaced">{{.ActiveCount}}</span>{{end}}
    </a>
    <a class="btn {{if eq .StatusFilter "closed"}}neutral{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=closed">
      Завершенные
    </a>
  </div>
</div>

{{if not .Sessions}}
<div class="card support-empty">
  <div class="support-empty-icon">🎉</div>
  <h3>Нет обращений в очереди</h3>
  <p class="muted">В данный момент никто из сотрудников не ожидает удаленной помощи по выбранным фильтрам.</p>
</div>
{{else}}
<div class="support-list" data-auto-refresh="6" data-waiting-count="{{.WaitingCount}}">
  {{range .Sessions}}
  {{$isClosed := or (eq .Status "completed") (eq .Status "ended_by_admin") (eq .Status "rejected") (eq .Status "cancelled")}}
  {{$isWaiting := eq .Status "requested"}}
  {{$isConnecting := eq .Status "connecting"}}
  {{$isActive := or (eq .Status "active") (eq .Status "transferred")}}

  <div class="card support-card-compact {{if $isClosed}}support-closed{{else if $isWaiting}}support-waiting{{else if $isConnecting}}support-connecting{{else}}support-active{{end}}">
    <!-- Левая колонка: пользователь, устройство, мета -->
    <div class="support-col-user">
      <div class="user-avatar" data-avatar-bg="{{.Username}}">
        {{userInitials .DisplayName .Username}}
      </div>
      <div class="support-user-details">
        <div class="support-title-row">
          <strong class="support-user-title">{{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}</strong>
          {{if and .DisplayName (ne .DisplayName .Username)}}
            <span class="muted support-user-sub">@{{.Username}}</span>
          {{end}}
          <span class="badge {{if eq .Category "1c"}}warn{{else if eq .Category "it"}}info{{else}}neutral{{end}}">
            {{if eq .Category "1c"}}📊 1С{{else if eq .Category "it"}}🖥 IT{{else}}🛟 {{.Category}}{{end}}
          </span>
          <span class="badge {{if $isActive}}ok{{else if $isWaiting}}warn{{else if $isConnecting}}info{{else if eq .Status "rejected"}}danger{{else}}neutral{{end}}">
            {{if $isWaiting}}🟡 Ожидает инженера{{else if $isConnecting}}🔵 2FA авторизация{{else if eq .Status "active"}}🟢 Сессия активна{{else if eq .Status "transferred"}}🟣 Переадресована{{else if eq .Status "completed"}}⚪ Завершена{{else if eq .Status "ended_by_admin"}}⚪ Завершена инженером{{else if eq .Status "rejected"}}🔴 Отклонена{{else if eq .Status "cancelled"}}⚪ Отменена{{else}}{{.Status}}{{end}}
          </span>
        </div>

        <div class="support-meta">
          <span>💻 <b>{{if .DeviceName}}{{.DeviceName}}{{else}}{{.Platform}}{{end}}</b> ({{.Platform}})</span>
          <span class="dot-sep">•</span>
          <span>🌐 {{.LastIP}}</span>
          <span class="dot-sep">•</span>
          <span>🕒 {{dt .CreatedAt}}</span>
          {{if .EndedAt}}
            <span class="dot-sep">•</span>
            <span>🏁 {{dt .EndedAt}}</span>
          {{end}}
        </div>
      </div>
    </div>

    <!-- Центральная колонка: суть проблемы -->
    <div class="support-col-problem">
      <div class="support-problem-badge">Суть проблемы</div>
      <div class="support-problem-quote">
        "{{.ProblemSummary}}"
      </div>
    </div>

    <!-- Правая колонка: действия оператора -->
    <div class="support-col-actions">
      {{if not $isClosed}}
        <a class="btn secondary sm" href="/admin/support/{{.ID}}/viewer?chat=1" title="Открыть текстовый чат по заявке без захвата экрана">💬 Чат</a>
        <a class="btn {{if $isWaiting}}primary pulse-btn{{else if $isConnecting}}info{{else}}ok{{end}} sm" href="/admin/support/{{.ID}}/viewer">
          {{if eq .Status "active"}}Перейти к экрану 🖥{{else if $isConnecting}}К авторизации 🔵{{else}}Подключиться ⚡{{end}}
        </a>
      {{else}}
        <span class="muted support-closed-text">Сессия закрыта</span>
      {{end}}

      <form action="/admin/support" method="post" class="inline-form">
        {{csrf $.CSRF}}
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="id" value="{{.ID}}">
        <button type="submit" class="btn ghost sm danger" data-confirm="Удалить запись об этом обращении?" title="Удалить обращение">🗑</button>
      </form>
    </div>
  </div>
  {{end}}
</div>
{{end}}

<!-- Модальное окно настроек категорий и порогов телеметрии -->
<div id="support-settings-modal" class="viewer-modal-backdrop">
  <div class="support-modal-window">
    <!-- Sticky Header -->
    <div class="support-modal-header">
      <div class="support-modal-header-text">
        <h3 class="support-modal-title">
          <span>⚙️</span> Настройки категорий SOS и порогов телеметрии
        </h3>
        <p class="support-modal-desc">
          Маршрутизация обращений сотрудников (Email / Telegram) и тревожные пороги ресурсов ПК.
        </p>
      </div>
      <button type="button" class="btn ghost sm support-modal-close-btn" id="btn-close-support-settings" title="Закрыть">✕</button>
    </div>

    <!-- Main Form -->
    <form action="/admin/support" method="post" class="support-modal-form">
      {{csrf .CSRF}}
      <input type="hidden" name="action" value="save_settings">

      <!-- Scrollable Body -->
      <div class="support-modal-scroll-body">
        
        <!-- Секция 1: Категории -->
        <div class="support-modal-section">
          <div class="support-section-title-row">
            <div>
              <h4 class="support-section-heading">Категории обращений и маршрутизация</h4>
              <p class="support-section-subheading">При поступлении заявки инженерам отправляется push, email и уведомление в Telegram.</p>
            </div>
            <button type="button" class="btn sm ghost support-add-category-btn" id="btn-add-category-row">+ Добавить категорию</button>
          </div>

          <div class="support-categories-table-wrap">
            <table class="table support-categories-table" id="categories-table">
              <thead>
                <tr>
                  <th class="th-cat-id">ID</th>
                  <th class="th-cat-name">Название</th>
                  <th class="th-cat-icon">Иконка</th>
                  <th class="th-cat-emails">Email-адреса пересылки</th>
                  <th class="th-cat-tg">Telegram Chat ID</th>
                  <th class="th-cat-del"></th>
                </tr>
              </thead>
              <tbody id="categories-tbody">
                {{range .Categories}}
                <tr>
                  <td>
                    <input type="text" name="cat_id[]" class="input sm mono cat-input-field" value="{{.ID}}" required placeholder="it">
                  </td>
                  <td>
                    <input type="text" name="cat_title[]" class="input sm cat-input-field" value="{{.Name}}" required placeholder="IT-служба">
                  </td>
                  <td class="td-icon-center">
                    <input type="text" name="cat_icon[]" class="input sm cat-input-field cat-icon-input" value="{{.Icon}}" placeholder="🖥">
                  </td>
                  <td>
                    <input type="text" name="cat_emails[]" class="input sm cat-input-field" value="{{join .Emails ", "}}" placeholder="support@corp.ru">
                  </td>
                  <td>
                    <input type="text" name="cat_telegram[]" class="input sm mono cat-input-field" value="{{if .TelegramChat}}{{.TelegramChat}}{{end}}" placeholder="-100...">
                  </td>
                  <td class="td-del-center">
                    <button type="button" class="btn ghost sm danger cat-row-del" title="Удалить категорию">✕</button>
                  </td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          <div class="support-categories-help">
            💡 Письмо приходит на указанные адреса с полем <code>Reply-To</code> сотрудника, ФИО, именем ПК, IP и описанием проблемы. <code>Telegram Chat ID</code> — числовой ID группы или канала (начинается с <code>-100</code>).
          </div>
        </div>

        <!-- Секция 2: Пороги телеметрии -->
        <div class="support-thresholds-section">
          <h4 class="support-section-heading">Пороги предупреждений телеметрии (Диски и 100% CPU)</h4>
          <p class="support-section-subheading">При превышении порогов индикаторы состояния в консоли оператора загораются тревожным цветом.</p>
          
          <div class="support-thresholds-grid">
            <div class="support-threshold-col">
              <span class="support-threshold-label">Порог заполнения диска (%)</span>
              <div class="support-unit-wrap">
                <input type="number" name="disk_warning_percent" class="input sm support-unit-input" value="{{if .Settings.DiskWarningPercent}}{{.Settings.DiskWarningPercent}}{{else}}90{{end}}" min="1" max="100">
                <span class="support-unit-suffix">%</span>
              </div>
            </div>

            <div class="support-threshold-col">
              <span class="support-threshold-label">Мин. места на диске (ГБ)</span>
              <div class="support-unit-wrap">
                <input type="number" name="disk_warning_min_gb" class="input sm support-unit-input" value="{{if .Settings.DiskWarningMinGB}}{{.Settings.DiskWarningMinGB}}{{else}}10{{end}}" min="1">
                <span class="support-unit-suffix">ГБ</span>
              </div>
            </div>

            <div class="support-threshold-col">
              <span class="support-threshold-label">Порог нагрузки CPU (%)</span>
              <div class="support-unit-wrap">
                <input type="number" name="cpu_warning_percent" class="input sm support-unit-input" value="{{if .Settings.CpuWarningPercent}}{{.Settings.CpuWarningPercent}}{{else}}95{{end}}" min="1" max="100">
                <span class="support-unit-suffix">%</span>
              </div>
            </div>

            <div class="support-threshold-col">
              <span class="support-threshold-label">Пик 100% CPU (сек)</span>
              <div class="support-unit-wrap">
                <input type="number" name="cpu_spike_duration_sec" class="input sm support-unit-input" value="{{if .Settings.CpuSpikeDurationSec}}{{.Settings.CpuSpikeDurationSec}}{{else}}30{{end}}" min="5">
                <span class="support-unit-suffix">сек</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Sticky Footer Actions (Always Visible!) -->
      <div class="actions support-modal-actions">
        <button type="button" class="btn ghost support-btn-cancel" id="btn-cancel-support-settings">Отмена</button>
        <button type="submit" class="btn primary support-btn-save">💾 Сохранить настройки</button>
      </div>
    </form>
  </div>
</div>
{{end}}
