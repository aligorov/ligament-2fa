{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<div class="page-head">
  <div class="page-title-row">
    <div>
      <h1 class="page-title">🛟 Удаленная помощь (SOS)</h1>
      <p class="page-sub">Очередь экстренных обращений сотрудников компании за помощью по IT-инфраструктуре и 1С.</p>
    </div>
  </div>
</div>

<div class="tabs" style="margin-bottom: 20px; display: flex; gap: 8px;">
  <a class="btn {{if or (eq .CategoryFilter "") (eq .CategoryFilter "all")}}primary{{else}}ghost{{end}} sm" href="/admin/support?category=all{{if .StatusFilter}}&status={{.StatusFilter}}{{end}}">
    Все категории
  </a>
  <a class="btn {{if eq .CategoryFilter "it"}}primary{{else}}ghost{{end}} sm" href="/admin/support?category=it{{if .StatusFilter}}&status={{.StatusFilter}}{{end}}">
    🖥 IT-служба
  </a>
  <a class="btn {{if eq .CategoryFilter "1c"}}primary{{else}}ghost{{end}} sm" href="/admin/support?category=1c{{if .StatusFilter}}&status={{.StatusFilter}}{{end}}">
    📊 Поддержка 1С
  </a>
</div>

{{if not .Sessions}}
<div class="card" style="text-align: center; padding: 48px 24px;">
  <div style="font-size: 3rem; margin-bottom: 12px;">🎉</div>
  <h3>Нет обращений в очереди</h3>
  <p class="muted">В данный момент никто из сотрудников не запрашивал удаленной помощи.</p>
</div>
{{else}}
<div style="display: flex; flex-direction: column; gap: 16px;">
  {{range .Sessions}}
  <div class="card" style="border-left: 4px solid {{if eq .Category "1c"}}#f59e0b{{else}}#3b82f6{{end}};">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
      <div style="display: flex; gap: 12px; align-items: center;">
        <div class="user-avatar" style="background-color: {{userAvatarBg .Username}};">
          {{userInitials .DisplayName .Username}}
        </div>
        <div>
          <div style="display: flex; gap: 8px; align-items: center;">
            <strong style="font-size: 1.1rem;">{{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}</strong>
            {{if and .DisplayName (ne .DisplayName .Username)}}
              <span class="muted" style="font-size: 0.85rem;">@{{.Username}}</span>
            {{end}}
            {{if eq .Category "1c"}}
              <span class="badge warn">📊 1С</span>
            {{else}}
              <span class="badge info">🖥 IT</span>
            {{end}}
            <span class="badge {{if eq .Status "active"}}ok{{else if eq .Status "requested"}}warn{{else if eq .Status "transferred"}}info{{else}}neutral{{end}}">
              {{if eq .Status "requested"}}Ожидает инженера{{else if eq .Status "connecting"}}2FA авторизация{{else if eq .Status "active"}}Сессия активна{{else if eq .Status "transferred"}}Переадресована{{else}}{{.Status}}{{end}}
            </span>
          </div>
          <div class="muted" style="font-size: 0.82rem; margin-top: 3px;">
            <span>💻 {{if .DeviceName}}{{.DeviceName}}{{else}}{{.Platform}}{{end}} ({{.Platform}})</span>
            <span class="dot-sep">•</span>
            <span>🌐 IP: {{.LastIP}}</span>
            <span class="dot-sep">•</span>
            <span>🕒 {{dt .CreatedAt}}</span>
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 8px; align-items: center;">
        <a class="btn primary sm" href="/admin/support/{{.ID}}/viewer">
          {{if eq .Status "active"}}Перейти к экрану 🖥{{else}}Подключиться ⚡{{end}}
        </a>
      </div>
    </div>

    <div style="margin-top: 14px; background: rgba(0,0,0,0.03); border-radius: 6px; padding: 12px 16px; border-left: 3px solid #cbd5e1;">
      <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; color: #64748b; margin-bottom: 4px;">
        Суть проблемы:
      </div>
      <div style="font-size: 0.95rem; line-height: 1.4; color: #1e293b;">
        "{{.ProblemSummary}}"
      </div>
    </div>
  </div>
  {{end}}
</div>
{{end}}

<script>
// Автообновление очереди заявок каждые 6 секунд
setTimeout(function() {
  if (!document.hidden) {
    location.reload();
  }
}, 6000);
</script>
{{end}}
