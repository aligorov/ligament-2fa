{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<div class="page-head">
  <div class="page-title-row" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 class="page-title">🛟 Удаленная помощь (SOS)</h1>
      <p class="page-sub">Очередь экстренных обращений сотрудников компании за помощью и удаленное подключение к рабочим местам.</p>
    </div>
    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <button type="button" class="btn ghost sm" id="btn-toggle-sound" title="Включить звуковой сигнал при появлении новых заявок">
        🔔 Звук: Выкл
      </button>
      <button type="button" class="btn secondary sm" id="btn-open-support-settings">
        ⚙️ Категории и пороги
      </button>
      <form action="/admin/support" method="post" style="display: inline;">
        {{csrf .CSRF}}
        <input type="hidden" name="action" value="cleanup">
        <button type="submit" class="btn ghost sm danger" data-confirm="Удалить все завершенные, отклоненные и отмененные обращения?">
          🧹 Очистить завершенные
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Верхняя сводка (KPI-счетчики) -->
<div class="support-kpi-grid">
  <a class="card support-kpi-card {{if eq .StatusFilter "requested"}}active{{end}}" href="/admin/support?status=requested{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val {{if gt .WaitingCount 0}}pulse-warn{{end}}">
      {{.WaitingCount}}
    </div>
    <div class="support-kpi-label">
      🟡 Ожидают инженера
    </div>
  </a>

  <a class="card support-kpi-card {{if eq .StatusFilter "connecting"}}active{{end}}" href="/admin/support?status=connecting{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val" style="color: var(--primary);">
      {{.ConnectingCount}}
    </div>
    <div class="support-kpi-label">
      🔵 2FA Авторизация
    </div>
  </a>

  <a class="card support-kpi-card {{if eq .StatusFilter "active"}}active{{end}}" href="/admin/support?status=active{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val" style="color: var(--ok, #10b981);">
      {{.ActiveCount}}
    </div>
    <div class="support-kpi-label">
      🟢 В процессе
    </div>
  </a>

  <a class="card support-kpi-card {{if eq .StatusFilter "closed"}}active{{end}}" href="/admin/support?status=closed{{if .CategoryFilter}}&category={{.CategoryFilter}}{{end}}">
    <div class="support-kpi-val" style="color: var(--muted);">
      {{.ClosedCount}}
    </div>
    <div class="support-kpi-label">
      ⚪ Завершено
    </div>
  </a>
</div>

<!-- Фильтры по категориям и статусам -->
<div class="support-toolbar-row">
  <div class="support-filters-group">
    <a class="btn {{if or (eq .CategoryFilter "") (eq .CategoryFilter "all")}}primary{{else}}ghost{{end}} sm" href="/admin/support?category=all{{if .StatusFilter}}&status={{.StatusFilter}}{{end}}">
      Все категории
    </a>
    {{range .Categories}}
    <a class="btn {{if eq $.CategoryFilter .ID}}primary{{else}}ghost{{end}} sm" href="/admin/support?category={{.ID}}{{if $.StatusFilter}}&status={{$.StatusFilter}}{{end}}">
      {{.Icon}} {{.Name}}
    </a>
    {{end}}
  </div>

  <div class="support-filters-group">
    <span class="muted" style="font-size: 0.85rem;">Статус:</span>
    <a class="btn {{if or (eq .StatusFilter "") (eq .StatusFilter "all")}}secondary{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=all">
      Все
    </a>
    <a class="btn {{if eq .StatusFilter "requested"}}warn{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=requested">
      Ожидают {{if .WaitingCount}}<span class="badge warn sm" style="margin-left: 4px;">{{.WaitingCount}}</span>{{end}}
    </a>
    <a class="btn {{if eq .StatusFilter "active"}}ok{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=active">
      Активные {{if .ActiveCount}}<span class="badge ok sm" style="margin-left: 4px;">{{.ActiveCount}}</span>{{end}}
    </a>
    <a class="btn {{if eq .StatusFilter "closed"}}neutral{{else}}ghost{{end}} sm" href="/admin/support?{{if .CategoryFilter}}category={{.CategoryFilter}}&{{end}}status=closed">
      Завершенные
    </a>
  </div>
</div>

{{if not .Sessions}}
<div class="card support-empty">
  <div class="support-empty-icon">🎉</div>
  <h3>Нет обращений в очереди</h3>
  <p class="muted">В данный момент никто из сотрудников не ожидает удаленной помощи по выбранным фильтрам.</p>
</div>
{{else}}
<div class="support-list" data-auto-refresh="6" data-waiting-count="{{.WaitingCount}}">
  {{range .Sessions}}
  {{$isClosed := or (eq .Status "completed") (eq .Status "ended_by_admin") (eq .Status "rejected") (eq .Status "cancelled")}}
  {{$isWaiting := eq .Status "requested"}}
  {{$isConnecting := eq .Status "connecting"}}
  {{$isActive := or (eq .Status "active") (eq .Status "transferred")}}

  <div class="card support-card-compact {{if $isClosed}}support-closed{{else if $isWaiting}}support-waiting{{else if $isConnecting}}support-connecting{{else}}support-active{{end}}">
    <!-- Левая колонка: пользователь, устройство, мета -->
    <div class="support-col-user">
      <div class="user-avatar" data-avatar-bg="{{.Username}}">
        {{userInitials .DisplayName .Username}}
      </div>
      <div class="support-user-details">
        <div class="support-title-row">
          <strong class="support-user-title">{{if .DisplayName}}{{.DisplayName}}{{else}}{{.Username}}{{end}}</strong>
          {{if and .DisplayName (ne .DisplayName .Username)}}
            <span class="muted support-user-sub">@{{.Username}}</span>
          {{end}}
          <span class="badge {{if eq .Category "1c"}}warn{{else if eq .Category "it"}}info{{else}}neutral{{end}}">
            {{if eq .Category "1c"}}📊 1С{{else if eq .Category "it"}}🖥 IT{{else}}🛟 {{.Category}}{{end}}
          </span>
          <span class="badge {{if $isActive}}ok{{else if $isWaiting}}warn{{else if $isConnecting}}info{{else if eq .Status "rejected"}}danger{{else}}neutral{{end}}">
            {{if $isWaiting}}🟡 Ожидает инженера{{else if $isConnecting}}🔵 2FA авторизация{{else if eq .Status "active"}}🟢 Сессия активна{{else if eq .Status "transferred"}}🟣 Переадресована{{else if eq .Status "completed"}}⚪ Завершена{{else if eq .Status "ended_by_admin"}}⚪ Завершена инженером{{else if eq .Status "rejected"}}🔴 Отклонена{{else if eq .Status "cancelled"}}⚪ Отменена{{else}}{{.Status}}{{end}}
          </span>
        </div>

        <div class="support-meta">
          <span>💻 <b>{{if .DeviceName}}{{.DeviceName}}{{else}}{{.Platform}}{{end}}</b> ({{.Platform}})</span>
          <span class="dot-sep">•</span>
          <span>🌐 {{.LastIP}}</span>
          <span class="dot-sep">•</span>
          <span>🕒 {{dt .CreatedAt}}</span>
          {{if .EndedAt}}
            <span class="dot-sep">•</span>
            <span>🏁 {{dt .EndedAt}}</span>
          {{end}}
        </div>
      </div>
    </div>

    <!-- Центральная колонка: суть проблемы -->
    <div class="support-col-problem">
      <div class="support-problem-badge">Суть проблемы</div>
      <div class="support-problem-quote">
        "{{.ProblemSummary}}"
      </div>
    </div>

    <!-- Правая колонка: действия оператора -->
    <div class="support-col-actions">
      {{if not $isClosed}}
        <a class="btn secondary sm" href="/admin/support/{{.ID}}/viewer?chat=1" title="Открыть текстовый чат по заявке без захвата экрана">💬 Чат</a>
        <a class="btn {{if $isWaiting}}primary pulse-btn{{else if $isConnecting}}info{{else}}ok{{end}} sm" href="/admin/support/{{.ID}}/viewer">
          {{if eq .Status "active"}}Перейти к экрану 🖥{{else if $isConnecting}}К авторизации 🔵{{else}}Подключиться ⚡{{end}}
        </a>
      {{else}}
        <span class="muted" style="font-size: 0.8rem;">Сессия закрыта</span>
      {{end}}

      <form action="/admin/support" method="post" style="display: inline;">
        {{csrf $.CSRF}}
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="id" value="{{.ID}}">
        <button type="submit" class="btn ghost sm danger" data-confirm="Удалить запись об этом обращении?" title="Удалить обращение">🗑</button>
      </form>
    </div>
  </div>
  {{end}}
</div>
{{end}}

<!-- Модальное окно настроек категорий и порогов телеметрии -->
<div id="support-settings-modal" class="viewer-modal-backdrop">
  <div class="card support-modal-window" style="width: 960px; max-width: 96vw; max-height: 90vh; display: flex; flex-direction: column; padding: 0; overflow: hidden; box-sizing: border-box; background: var(--surface, #1e293b); border: 1px solid var(--line, #334155); border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.75);">
    <!-- Sticky Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 20px 24px 16px; border-bottom: 1px solid var(--line, #334155); background: var(--surface, #1e293b); flex-shrink: 0;">
      <div>
        <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #f8fafc; display: flex; align-items: center; gap: 8px;">
          <span>⚙️</span> Настройки категорий SOS и порогов телеметрии
        </h3>
        <p class="muted" style="margin: 6px 0 0 0; font-size: 0.85rem; color: #94a3b8;">
          Маршрутизация обращений сотрудников (Email / Telegram) и тревожные пороги ресурсов ПК.
        </p>
      </div>
      <button type="button" class="btn ghost sm" id="btn-close-support-settings" title="Закрыть" style="font-size: 1.25rem; line-height: 1; padding: 6px 12px; border-radius: 8px; cursor: pointer; color: #94a3b8;">✕</button>
    </div>

    <!-- Main Form -->
    <form action="/admin/support" method="post" style="display: flex; flex-direction: column; flex: 1; min-height: 0; margin: 0; width: 100%;">
      {{csrf .CSRF}}
      <input type="hidden" name="action" value="save_settings">

      <!-- Scrollable Body -->
      <div class="support-modal-scroll-body" style="overflow-y: auto; flex: 1; min-height: 0; padding: 20px 24px;">
        
        <!-- Секция 1: Категории -->
        <div style="margin-bottom: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <div>
              <h4 style="margin: 0; font-size: 1rem; font-weight: 600; color: #f1f5f9;">Категории обращений и маршрутизация</h4>
              <p class="muted" style="margin: 2px 0 0; font-size: 0.8rem; color: #94a3b8;">При поступлении заявки инженерам отправляется push, email и уведомление в Telegram.</p>
            </div>
            <button type="button" class="btn sm ghost" id="btn-add-category-row" style="border: 1px dashed var(--accent, #38bdf8); color: var(--accent, #38bdf8); font-weight: 600; padding: 6px 14px; border-radius: 8px;">+ Добавить категорию</button>
          </div>

          <div style="border: 1px solid var(--line, #334155); border-radius: 10px; overflow-x: auto; background: var(--bg, #0f172a);">
            <table class="table" id="categories-table" style="width: 100%; min-width: 780px; border-collapse: collapse; margin: 0;">
              <thead>
                <tr style="background: rgba(255, 255, 255, 0.03); border-bottom: 1px solid var(--line, #334155);">
                  <th style="width: 100px; padding: 10px 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; text-align: left;">ID</th>
                  <th style="width: 160px; padding: 10px 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; text-align: left;">Название</th>
                  <th style="width: 70px; padding: 10px 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; text-align: center;">Иконка</th>
                  <th style="padding: 10px 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; text-align: left;">Email-адреса пересылки</th>
                  <th style="width: 170px; padding: 10px 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; text-align: left;">Telegram Chat ID</th>
                  <th style="width: 46px; padding: 10px 12px;"></th>
                </tr>
              </thead>
              <tbody id="categories-tbody">
                {{range .Categories}}
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                  <td style="padding: 8px 12px;">
                    <input type="text" name="cat_id[]" class="input sm mono" value="{{.ID}}" required placeholder="it" style="width: 100%; box-sizing: border-box; font-family: monospace;">
                  </td>
                  <td style="padding: 8px 12px;">
                    <input type="text" name="cat_title[]" class="input sm" value="{{.Name}}" required placeholder="IT-служба" style="width: 100%; box-sizing: border-box;">
                  </td>
                  <td style="padding: 8px 12px; text-align: center;">
                    <input type="text" name="cat_icon[]" class="input sm" value="{{.Icon}}" style="width: 100%; box-sizing: border-box; text-align: center;" placeholder="🖥">
                  </td>
                  <td style="padding: 8px 12px;">
                    <input type="text" name="cat_emails[]" class="input sm" value="{{join .Emails ", "}}" placeholder="support@corp.ru" style="width: 100%; box-sizing: border-box;">
                  </td>
                  <td style="padding: 8px 12px;">
                    <input type="text" name="cat_telegram[]" class="input sm mono" value="{{if .TelegramChat}}{{.TelegramChat}}{{end}}" placeholder="-100..." style="width: 100%; box-sizing: border-box; font-family: monospace;">
                  </td>
                  <td style="padding: 8px 12px; text-align: center;">
                    <button type="button" class="btn ghost sm danger cat-row-del" title="Удалить категорию" style="padding: 4px 8px; border-radius: 6px; cursor: pointer; color: #ef4444;">✕</button>
                  </td>
                </tr>
                {{end}}
              </tbody>
            </table>
          </div>
          <div style="margin-top: 8px; font-size: 0.8rem; color: #64748b; line-height: 1.4;">
            💡 Письмо приходит на указанные адреса с полем <code>Reply-To</code> сотрудника, ФИО, именем ПК, IP и описанием проблемы. <code>Telegram Chat ID</code> — числовой ID группы или канала (начинается с <code>-100</code>).
          </div>
        </div>

        <!-- Секция 2: Пороги телеметрии -->
        <div style="padding: 18px 20px; background: var(--bg, #0f172a); border: 1px solid var(--line, #334155); border-radius: 12px;">
          <h4 style="margin: 0 0 4px 0; font-size: 1rem; font-weight: 600; color: #f1f5f9;">Пороги предупреждений телеметрии (Диски и 100% CPU)</h4>
          <p class="muted" style="margin: 0 0 14px 0; font-size: 0.8rem; color: #94a3b8;">При превышении порогов индикаторы состояния в консоли оператора загораются тревожным цветом.</p>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <span style="font-size: 0.8rem; font-weight: 500; color: #cbd5e1;">Порог заполнения диска (%)</span>
              <div style="position: relative; display: flex; align-items: center;">
                <input type="number" name="disk_warning_percent" class="input sm" value="{{if .Settings.DiskWarningPercent}}{{.Settings.DiskWarningPercent}}{{else}}90{{end}}" min="1" max="100" style="width: 100%; padding-right: 28px; box-sizing: border-box;">
                <span style="position: absolute; right: 10px; color: #64748b; font-size: 0.85rem; pointer-events: none;">%</span>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px;">
              <span style="font-size: 0.8rem; font-weight: 500; color: #cbd5e1;">Мин. места на диске (ГБ)</span>
              <div style="position: relative; display: flex; align-items: center;">
                <input type="number" name="disk_warning_min_gb" class="input sm" value="{{if .Settings.DiskWarningMinGB}}{{.Settings.DiskWarningMinGB}}{{else}}10{{end}}" min="1" style="width: 100%; padding-right: 32px; box-sizing: border-box;">
                <span style="position: absolute; right: 10px; color: #64748b; font-size: 0.85rem; pointer-events: none;">ГБ</span>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px;">
              <span style="font-size: 0.8rem; font-weight: 500; color: #cbd5e1;">Порог нагрузки CPU (%)</span>
              <div style="position: relative; display: flex; align-items: center;">
                <input type="number" name="cpu_warning_percent" class="input sm" value="{{if .Settings.CpuWarningPercent}}{{.Settings.CpuWarningPercent}}{{else}}95{{end}}" min="1" max="100" style="width: 100%; padding-right: 28px; box-sizing: border-box;">
                <span style="position: absolute; right: 10px; color: #64748b; font-size: 0.85rem; pointer-events: none;">%</span>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px;">
              <span style="font-size: 0.8rem; font-weight: 500; color: #cbd5e1;">Пик 100% CPU (сек)</span>
              <div style="position: relative; display: flex; align-items: center;">
                <input type="number" name="cpu_spike_duration_sec" class="input sm" value="{{if .Settings.CpuSpikeDurationSec}}{{.Settings.CpuSpikeDurationSec}}{{else}}30{{end}}" min="5" style="width: 100%; padding-right: 36px; box-sizing: border-box;">
                <span style="position: absolute; right: 10px; color: #64748b; font-size: 0.85rem; pointer-events: none;">сек</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Sticky Footer Actions (Always Visible!) -->
      <div class="actions support-modal-actions" style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; padding: 16px 24px; border-top: 1px solid var(--line, #334155); background: var(--surface, #1e293b); flex-shrink: 0; box-sizing: border-box;">
        <button type="button" class="btn ghost" id="btn-cancel-support-settings" style="padding: 9px 18px; border-radius: 8px; font-weight: 500; cursor: pointer;">Отмена</button>
        <button type="submit" class="btn primary" style="padding: 9px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; background: #0284c7; color: white; border: none; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);">💾 Сохранить настройки</button>
      </div>
    </form>
  </div>
</div>
{{end}}
