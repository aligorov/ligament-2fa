{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<div id="support-viewer" class="viewer-layout" data-session-id="{{.Session.ID}}" data-ws-endpoint="{{.WSEndpoint}}" data-transfer-token="{{.TransferToken}}" data-operator-name="{{.BaseData.Username}}">
  <!-- Header Bar -->
  <div class="card viewer-head">
    <div class="viewer-user">
      <a class="btn ghost sm" href="/admin/support">← В очередь</a>
      <div>
        <div class="support-title-row">
          <strong class="viewer-user-name">{{if .Session.DisplayName}}{{.Session.DisplayName}}{{else}}{{.Session.Username}}{{end}}</strong>
          {{if eq .Session.Category "1c"}}
            <span class="badge warn">📊 1С-поддержка</span>
          {{else}}
            <span class="badge info">🖥 IT-поддержка</span>
          {{end}}
          <span id="session-status-badge" class="badge ok">{{.Session.Status}}</span>
        </div>
        <div class="viewer-user-meta">
          <span>ПК: {{if .Session.DeviceName}}{{.Session.DeviceName}}{{else}}{{.Session.Platform}}{{end}}</span>
          <span class="dot-sep">•</span>
          <span>IP: {{.Session.LastIP}}</span>
          <span class="dot-sep">•</span>
          <span>Режим: {{if eq .Session.AccessMode "full_control"}}Полное управление{{else}}Только просмотр{{end}}</span>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="viewer-actions">
      <button id="btn-toggle-control" class="btn secondary sm" data-action="toggle-control">
        🎮 Включить управление
      </button>
      <button id="btn-transfer" class="btn info sm" data-action="open-transfer">
        🔄 Переадресовать сессию
      </button>
      <button id="btn-end-session" class="btn err sm" data-action="end-session">
        ⏹ Завершить сеанс
      </button>
    </div>
  </div>

  <!-- Problem summary banner -->
  <div class="card viewer-problem-banner">
    <div class="viewer-problem-title">
      Суть проблемы:
    </div>
    <div class="viewer-problem-text">
      "{{.Session.ProblemSummary}}"
    </div>
  </div>

  <!-- 2FA Number Match Notice -->
  <div id="number-match-card" class="card number-match-card{{if and (eq .Session.Status "connecting") .Session.NumberMatch}} visible{{else}} hidden{{end}}">
    <div class="number-match-title">
      🔒 <strong>Безопасное Zero-Trust подключение</strong>
    </div>
    <p class="number-match-subtitle">
      Сообщите сотруднику контрольное число для подтверждения на его экране:
    </p>
    <div id="number-match-digits" class="number-match-digits">
      {{if .Session.NumberMatch}}{{.Session.NumberMatch}}{{else}}--{{end}}
    </div>
    <div class="number-match-hint">
      Ожидание выбора верного числа в приложении Ligament 2FA...
    </div>
  </div>

  <!-- Remote Screen Viewport -->
  <div class="card viewer-screen-card">
    <video id="remote-video" class="viewer-video" autoplay playsinline></video>
    
    <div id="video-placeholder" class="viewer-placeholder">
      <div class="viewer-spinner"></div>
      <div id="connection-status-text" class="viewer-status-text">Инициализация соединения...</div>
      <p class="viewer-status-sub">Устанавливается защищенный P2P WebRTC канал</p>
    </div>
  </div>
</div>

<!-- Modal: Transfer Session -->
<div id="transfer-modal" class="viewer-modal-backdrop">
  <div class="card viewer-modal-card">
    <h3>🔄 Переадресация удаленного доступа</h3>
    <p class="muted viewer-modal-sub">
      Вы можете передать управление активной сессией любому коллеге (даже если он не является инженером техподдержки).
    </p>

    <div class="field viewer-modal-field">
      <span class="field-label">Выберите коллегу</span>
      <select id="transfer-user-select" class="select">
        <option value="">-- Выбрать сотрудника из списка --</option>
        {{range .Colleagues}}
        <option value="{{.ID}}">{{if .DisplayName}}{{.DisplayName}} ({{.Username}}){{else}}{{.Username}}{{end}}</option>
        {{end}}
      </select>
    </div>

    <div class="viewer-modal-or">ИЛИ</div>

    <div class="field">
      <span class="field-label">Одноразовая защищенная ссылка</span>
      <div class="viewer-modal-input-row">
        <input id="transfer-link-input" type="text" class="input mono" readonly placeholder="Ссылка будет создана...">
        <button class="btn secondary sm" data-action="copy-transfer">Скопировать</button>
      </div>
      <span class="help">Ссылка предоставляет доступ к этому сеансу без прав глобального администратора.</span>
    </div>

    <div class="actions viewer-modal-actions">
      <button class="btn ghost" data-action="close-transfer">Отмена</button>
      <button class="btn primary" data-action="submit-transfer">Передать доступ</button>
    </div>
  </div>
</div>
{{end}}
