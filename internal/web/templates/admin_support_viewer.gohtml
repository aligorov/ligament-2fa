{{define "layout"}}
<div id="support-viewer" class="support-console-root" data-session-id="{{.Session.ID}}" data-ws-endpoint="{{.WSEndpoint}}" data-transfer-token="{{.TransferToken}}" data-operator-name="{{.BaseData.Username}}" data-access-mode="{{.Session.AccessMode}}">
  <form id="support-csrf-form" style="display:none;">{{csrf .CSRF}}</form>
  <!-- Slim Floating / Docked Top HUD Bar (44px) -->
  <header class="support-console-hud" id="support-hud">
    <!-- Left Section: Back, User Info, Problem Popover -->
    <div class="hud-section hud-left">
      <a class="hud-btn hud-btn-back" href="/admin/support" title="Вернуться к очереди SOS">
        ← В очередь
      </a>
      <div class="hud-user-pill">
        <span class="hud-user-name">{{if .Session.DisplayName}}{{.Session.DisplayName}}{{else}}{{.Session.Username}}{{end}}</span>
        <span class="hud-badge {{if eq .Session.Category "1c"}}badge-1c{{else}}badge-it{{end}}">
          {{if eq .Session.Category "1c"}}1С-поддержка{{else}}IT-поддержка{{end}}
        </span>
        <span id="session-status-badge" class="hud-status-badge">{{.Session.Status}}</span>
      </div>
      <div class="hud-popover-wrap">
        <button type="button" class="hud-btn hud-btn-info" id="btn-problem-toggle" title="Показать суть проблемы">
          ℹ️ Описание
        </button>
        <div class="hud-popover" id="hud-problem-popover">
          <div class="hud-popover-title">Ошибка 1С при формировании отчета:</div>
          <div class="hud-popover-text">"{{.Session.ProblemSummary}}"</div>
          <div class="hud-popover-meta">ПК: {{if .Session.DeviceName}}{{.Session.DeviceName}}{{else}}{{.Session.Platform}}{{end}} ({{.Session.Platform}}) • IP: {{.Session.LastIP}}</div>
        </div>
      </div>
    </div>

    <!-- Center Section: Screens, Scale, Hotkeys, Telemetry -->
    <div class="hud-section hud-center">
      <!-- Мониторы (динамические плашки) -->
      <div id="viewer-screen-pills" class="hud-screen-pills">
        <button type="button" class="hud-pill active" data-screen-id="default" title="Основной монитор">🖥 1</button>
      </div>
      <!-- Скрытый select для совместимости -->
      <select id="viewer-screen-select" style="display: none;">
        <option value="default">Основной монитор</option>
      </select>

      <div class="hud-divider"></div>

      <!-- Масштаб -->
      <div class="hud-btn-group">
        <button id="btn-scale-fit" type="button" class="hud-btn active" title="Вписать экран в окно">⤢ Вписать</button>
        <button id="btn-scale-orig" type="button" class="hud-btn" title="Оригинальный размер 1:1">1:1</button>
        <button id="btn-scale-in" type="button" class="hud-btn hud-btn-icon" title="Увеличить">+</button>
        <button id="btn-scale-out" type="button" class="hud-btn hud-btn-icon" title="Уменьшить">-</button>
      </div>

      <div class="hud-divider"></div>

      <!-- Быстрые горячие клавиши -->
      <div class="hud-btn-group">
        <button type="button" class="hud-btn hud-hotkey-btn" data-hotkey="ctrl_alt_del" title="Ctrl + Alt + Del">🔒 Ctrl+Alt+Del</button>
        <button type="button" class="hud-btn hud-hotkey-btn" data-hotkey="win_key" title="Клавиша Win">🪟 Win</button>
        <button type="button" class="hud-btn hud-hotkey-btn" data-hotkey="win_r" title="Win + R (Выполнить)">Win+R</button>
        <button type="button" class="hud-btn hud-hotkey-btn" data-hotkey="task_mgr" title="Диспетчер задач">⚡ Диспетчер</button>
        <select id="viewer-hotkey-select" class="hud-select" title="Другие комбинации клавиш">
          <option value="">▾ Еще...</option>
          <option value="alt_tab">Alt + Tab (Окна)</option>
          <option value="win_d">Win + D (Рабочий стол)</option>
          <option value="alt_f4">Alt + F4 (Закрыть окно)</option>
          <option value="esc">Esc</option>
        </select>
      </div>

      <div class="hud-divider"></div>

      <!-- Блокировка ввода и буфер обмена -->
      <button id="btn-block-input" type="button" class="hud-btn" title="Заблокировать локальную клавиатуру и мышь у клиента">
        🔒 Блок ввода клиента
      </button>

      <button id="btn-clipboard-toggle" type="button" class="hud-btn" title="Синхронизация буфера обмена">
        📋 Буфер обмена
      </button>

      <!-- Телеметрия ПК -->
      <div class="hud-telemetry">
        <span id="tel-cpu-badge" class="hud-tel-badge" title="Загрузка CPU">⚡ CPU: --%</span>
        <span id="tel-disk-badge" class="hud-tel-badge" title="Дисковое пространство">💾 Диск: --</span>
      </div>
    </div>

    <!-- Right Section: Control Mode, Fullscreen, Transfer, End -->
    <div class="hud-section hud-right">
      <button id="btn-toggle-control" class="hud-btn hud-btn-control" data-action="toggle-control">
        🎮 Включить управление
      </button>

      <button id="btn-fullscreen" class="hud-btn hud-btn-icon" title="На весь экран (F11)">
        ⛶
      </button>

      <button id="btn-transfer" class="hud-btn" data-action="open-transfer" title="Переадресовать сессию коллеге">
        🔄 Переадресовать сессию
      </button>

      <button id="btn-end-session" class="hud-btn hud-btn-danger" data-action="end-session" title="Завершить сеанс">
        ⏹ Завершить сеанс
      </button>

      <button id="btn-hud-pin" class="hud-btn hud-btn-icon hud-pin-btn" title="Закрепить/скрывать панель">
        📌
      </button>
    </div>
  </header>

  <!-- Выпадающая панель буфера обмена -->
  <div id="viewer-clipboard-drawer" class="hud-drawer">
    <div class="hud-drawer-head">
      <strong>📋 Синхронизация буфера обмена с удаленным ПК</strong>
      <button type="button" class="hud-btn hud-btn-icon" id="btn-clipboard-close">✕</button>
    </div>
    <div class="hud-drawer-body">
      <input type="text" id="clipboard-send-text" class="input sm" placeholder="Введите текст для отправки на ПК клиента..." style="flex: 1;">
      <button type="button" id="btn-clipboard-send" class="btn primary sm">Отправить в буфер клиента 📤</button>
      <button type="button" id="btn-clipboard-read" class="btn secondary sm">Прочитать с клиента 📥</button>
    </div>
    <div id="clipboard-read-result" style="display: none; margin-top: 8px; font-size: 0.85rem; color: var(--muted); word-break: break-all;">
      Получено из буфера: <code id="clipboard-read-val" class="mono" style="color: var(--text);"></code>
    </div>
  </div>

  <!-- Центрированный оверлей Zero-Trust 2FA (для connecting) -->
  <div id="number-match-card" class="number-match-overlay{{if and (eq .Session.Status "connecting") .Session.NumberMatch}} visible{{else}} hidden{{end}}">
    <div class="number-match-dialog">
      <div class="number-match-icon">🔒</div>
      <h3 class="number-match-title">Безопасное Zero-Trust подключение</h3>
      <p class="number-match-subtitle">Сообщите сотруднику контрольное число для подтверждения на его экране:</p>
      <div id="number-match-digits" class="number-match-digits">
        {{if .Session.NumberMatch}}{{.Session.NumberMatch}}{{else}}--{{end}}
      </div>
      <div class="number-match-hint">
        <span class="pulse-dot"></span> Ожидание выбора верного числа в приложении Ligament 2FA...
      </div>
    </div>
  </div>

  <!-- Основной холст удаленного рабочего стола (100% пространства) -->
  <main class="support-screen-canvas" id="viewer-screen-container" tabindex="0">
    <video id="remote-video" class="support-remote-video" autoplay playsinline muted></video>

    <div id="video-placeholder" class="viewer-placeholder">
      <div class="viewer-spinner"></div>
      <div id="connection-status-text" class="viewer-status-text">Инициализация защищенного WebRTC соединения...</div>
      <p class="viewer-status-sub">P2P канал с шифрованием DTLS/SRTP</p>
    </div>
  </main>
</div>

<!-- Модальное окно: Переадресация сессии -->
<div id="transfer-modal" class="viewer-modal-backdrop">
  <div class="card viewer-modal-card">
    <h3>🔄 Переадресация удаленного доступа</h3>
    <p class="muted viewer-modal-sub">
      Вы можете передать управление активной сессией любому коллеге (даже если он не является инженером техподдержки).
    </p>

    <div class="field viewer-modal-field">
      <span class="field-label">Выберите коллегу</span>
      <select id="transfer-user-select" class="select">
        <option value="">-- Выбрать сотрудника из списка --</option>
        {{range .Colleagues}}
        <option value="{{.ID}}">{{if .DisplayName}}{{.DisplayName}} ({{.Username}}){{else}}{{.Username}}{{end}}</option>
        {{end}}
      </select>
    </div>

    <div class="viewer-modal-or">ИЛИ</div>

    <div class="field">
      <span class="field-label">Одноразовая защищенная ссылка</span>
      <div class="viewer-modal-input-row">
        <input id="transfer-link-input" type="text" class="input mono" readonly placeholder="Ссылка будет создана...">
        <button class="btn secondary sm" data-action="copy-transfer">Скопировать</button>
      </div>
      <span class="help">Ссылка предоставляет доступ к этому сеансу без прав глобального администратора.</span>
    </div>

    <div class="actions viewer-modal-actions">
      <button class="btn ghost" data-action="close-transfer">Отмена</button>
      <button class="btn primary" data-action="submit-transfer">Передать доступ</button>
    </div>
  </div>
</div>
{{end}}
