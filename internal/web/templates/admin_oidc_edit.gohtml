{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Редактирование приложения OIDC</h1>
  <p class="page-sub">Настройка параметров и прав доступа для приложения <span class="mono">{{.Client.ClientID}}</span>.</p>
</header>

{{if .OneTimeSecret}}
<section class="card">
  <div class="card-head">
    <h2><span class="card-icon">🔑</span>Новый секрет сгенерирован</h2>
    <p>Секрет показывается только один раз — сохраните его в конфигурации приложения прямо сейчас.</p>
  </div>
  <p>client_id:</p>
  <pre class="one-time">{{.Client.ClientID}}</pre>
  <p>client_secret:</p>
  <pre class="one-time">{{.OneTimeSecret}}</pre>
</section>
{{end}}

<section class="card">
  <div class="card-head">
    <h2><span class="card-icon">⚙️</span>Параметры приложения</h2>
    <p>Изменение названия, списка разрешённых Redirect URI и ограничений доступа.</p>
  </div>
  <form action="/admin/oidc/clients/{{.Client.ID}}" method="post" class="form wide">
    {{csrf .CSRF}}

    <div class="field-row">
      <label class="field">
        <span class="field-label">Client ID</span>
        <input class="input mono" type="text" value="{{.Client.ClientID}}" readonly disabled style="opacity: 0.8;">
        <span class="help">Идентификатор клиента OIDC формируется при создании и не меняется.</span>
      </label>
      <div class="field">
        <span class="field-label">Тип клиента</span>
        <div style="padding-top: 6px;">
          {{if .Client.IsPublic}}
            <span class="badge neutral">Public-клиент (PKCE S256)</span>
          {{else}}
            <span class="badge info">Confidential (с секретом)</span>
          {{end}}
        </div>
      </div>
    </div>

    <label class="field">
      <span class="field-label">Название приложения</span>
      <input class="input" type="text" name="name" value="{{.Client.Name}}" required placeholder="Например: Proxmox PVE, Grafana">
    </label>

    <label class="field">
      <span class="field-label">Redirect URI (по одному в строке)</span>
      <textarea class="input mono" name="redirect_uris" rows="3" required>{{range .Client.RedirectURIs}}{{.}}
{{end}}</textarea>
      <span class="help">Строгое совпадение протокола, хоста и пути возврата кода.</span>
    </label>

    {{if not .Client.IsPublic}}
    <div class="field" style="margin-top: 6px;">
      <label class="check">
        <input type="checkbox" name="regenerate_secret" value="1">
        <span><b>Сгенерировать новый Client Secret</b></span>
      </label>
      <span class="help" style="margin-left: 24px;">Прежний секрет станет недействительным. Новый секрет отобразится после сохранения.</span>
    </div>
    {{end}}

    <div class="card-head" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line);">
      <h3><span class="card-icon">🔒</span>Контроль доступа</h3>
      <p>Определите, какие пользователи или группы могут входить в это приложение. Если ничего не выбрано — доступ открыт <b>всем</b> активным пользователям. Системные администраторы имеют доступ всегда.</p>
    </div>

    {{if .AllGroups}}
    <div class="field">
      <span class="field-label">Локальные группы (Ligament)</span>
      <div class="select-grid" style="max-height: 160px;">
        {{range .AllGroups}}
        <label class="select-chip">
          <input type="checkbox" name="allowed_groups" value="{{.Name}}"{{if hasStr $.Client.AllowedGroups .Name}} checked{{end}}>
          <div class="select-chip-label">
            <span>{{.Name}}</span>
            {{if .Description}}<span class="select-chip-sub">{{.Description}}</span>{{end}}
          </div>
        </label>
        {{end}}
      </div>
    </div>
    {{end}}

    {{if .LDAPGroups}}
    <div class="field">
      <span class="field-label">Группы LDAP / Active Directory</span>
      <div class="select-grid" style="max-height: 160px;">
        {{range .LDAPGroups}}
        <label class="select-chip" title="{{.}}">
          <input type="checkbox" name="allowed_groups" value="{{.}}"{{if or (hasStr $.Client.AllowedGroups .) (hasStr $.Client.AllowedGroups (groupCN .))}} checked{{end}}>
          <div class="select-chip-label">
            <span>{{groupCN .}}</span>
          </div>
        </label>
        {{end}}
      </div>
    </div>
    {{end}}

    {{if .AllUsers}}
    <div class="field">
      <span class="field-label">Отдельные пользователи</span>
      <div class="select-grid" style="max-height: 180px;">
        {{range .AllUsers}}
        <label class="select-chip">
          <input type="checkbox" name="allowed_users" value="{{.Username}}"{{if hasStr $.Client.AllowedUsers .Username}} checked{{end}}>
          <div class="select-chip-label">
            <span>{{.Username}}</span>
            {{if .DisplayName}}<span class="select-chip-sub">{{.DisplayName}}</span>{{end}}
          </div>
        </label>
        {{end}}
      </div>
    </div>
    {{end}}

    <label class="field">
      <span class="field-label">Дополнительные группы / DN вручную (по одной в строке)</span>
      <textarea class="input mono" name="manual_groups" rows="3" placeholder="CN=Proxmox-Users,OU=Groups,DC=company,DC=local">{{.ManualGroups}}</textarea>
      <span class="help">Укажите точные DN или имена групп Active Directory / OpenLDAP, если они ещё не встречались при синхронизации пользователей.</span>
    </label>

    <div class="form-actions" style="display: flex; gap: 8px; margin-top: 16px;">
      <button type="submit" class="btn primary">Сохранить изменения</button>
      <a href="/admin/oidc" class="btn secondary">Отмена</a>
    </div>
  </form>
</section>
{{end}}
