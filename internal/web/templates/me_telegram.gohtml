{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Telegram</h1>
  <p class="page-sub">Коды и push-подтверждения в чат-боте сервера.</p>
</header>

{{if .Linked}}
<section class="card">
  <div class="card-head">
    <h2>Telegram привязан{{with .ChatID}} · chat {{.}}{{end}}</h2>
    <p>Отвязка требует код из приложения или резервный код.</p>
  </div>
  <form action="/me/telegram/delete" method="post" class="form">
    {{csrf .CSRF}}
    <label class="field">
      <span class="field-label">Код подтверждения</span>
      <div class="field-with-btn">
        <input class="input code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required>
        <button type="submit" formaction="/me/send-code" formmethod="post" formnovalidate class="btn secondary" data-request-code>Запросить код</button>
      </div>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn danger">Отвязать Telegram</button>
    </div>
  </form>
</section>

{{else}}
<section class="card">
  {{if .LinkCode}}
  <div class="card-head">
    <h2>Код привязки получен</h2>
    <p>Отправьте его боту — бот указан в настройках сервера.</p>
  </div>
  <div class="copy-row">
    <span class="linkcode">{{.LinkCode}}</span>
    <button type="button" class="btn ghost sm" data-copy>Скопировать</button>
  </div>
  <p class="muted">Код действует ограниченное время.</p>
  <form action="/me/telegram/link" method="post" class="form form-tight">
    {{csrf .CSRF}}
    <label class="field">
      <span class="field-label">Код подтверждения</span>
      <div class="field-with-btn">
        <input class="input code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code"{{if .NeedCode}} required{{end}}>
        <button type="submit" formaction="/me/send-code" formmethod="post" formnovalidate class="btn secondary" data-request-code>Запросить код</button>
      </div>
      <span class="help">Код из приложения, резервный код или запросите на привязанный канал.</span>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn secondary">Получить новый код</button>
    </div>
  </form>
  {{else}}
  <div class="card-head">
    <h2>Привязка бота</h2>
    <p>Запросите код и отправьте его чат-боту сервера — после этого коды и
    push-подтверждения будут приходить в Telegram.</p>
  </div>
  <form action="/me/telegram/link" method="post" class="form">
    {{csrf .CSRF}}
    <label class="field">
      <span class="field-label">Код подтверждения</span>
      <div class="field-with-btn">
        <input class="input code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code"{{if .NeedCode}} required{{end}}>
        <button type="submit" formaction="/me/send-code" formmethod="post" formnovalidate class="btn secondary" data-request-code>Запросить код</button>
      </div>
      <span class="help">Выдача кода привязки — чувствительная операция:
      подтвердите её кодом второго фактора (из приложения, резервным или
      запросите на привязанный канал).</span>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn primary">Получить код привязки</button>
    </div>
  </form>
  {{end}}
</section>
{{end}}
{{end}}
