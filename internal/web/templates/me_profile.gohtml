{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Профиль{{if .User.DisplayName}} — {{.User.DisplayName}}{{end}}</h1>
  <p class="page-sub">Контакты, каналы доставки кодов и смена пароля.
  {{if eq .User.Source "ldap"}}Пароль проверяется каталогом
  LDAP/Active Directory.{{end}}</p>
</header>

<section class="card">
  <div class="card-head">
    <h2>Статус каналов</h2>
    <p>Какие второй факторы привязаны и где ими управлять.</p>
  </div>
  <div class="table-wrap">
    <table class="table">
      <tr><th>Канал</th><th>Статус</th><th></th></tr>
      <tr>
        <td>TOTP-приложение</td>
        <td>{{if .TOTPConfirmed}}<span class="badge ok">привязан</span>{{else}}<span class="badge neutral">не привязан</span>{{end}}</td>
        <td><a href="/me/totp">Управлять</a></td>
      </tr>
      <tr>
        <td>Резервные коды</td>
        <td><span class="badge neutral">осталось: {{.BackupRemaining}}</span></td>
        <td><a href="/me/backup">Управлять</a></td>
      </tr>
      <tr>
        <td>Telegram</td>
        <td>{{if .TelegramLinked}}<span class="badge ok">привязан</span>{{else}}<span class="badge neutral">не привязан</span>{{end}}</td>
        <td><a href="/me/telegram">Управлять</a></td>
      </tr>
      <tr>
        <td>Passkeys</td>
        <td><span class="badge neutral">ключей: {{.PasskeyCount}}</span></td>
        <td><a href="/me/passkeys">Управлять</a></td>
      </tr>
    </table>
  </div>
</section>

<section class="card">
  <div class="card-head">
    <h2>Контакты</h2>
    <p>Смена email или телефона требует код подтверждения на старый канал
    (или резервный код).</p>
  </div>
  <form action="/me/contacts" method="post" class="form">
    {{csrf .CSRF}}
    {{if .User.DisplayName}}
    <label class="field">
      <span class="field-label">Отображаемое имя{{if eq .User.Source "ldap"}} <span class="badge neutral">ldap</span>{{end}}</span>
      <input class="input" type="text" value="{{.User.DisplayName}}" readonly
        {{if eq .User.Source "ldap"}}title="Синхронизируется из каталога LDAP при каждом входе"{{end}}>
      {{if eq .User.Source "ldap"}}<span class="help">Синхронизируется из каталога при каждом входе.</span>{{end}}
    </label>
    {{end}}
    <div class="field-row">
      <label class="field">
        <span class="field-label">Email</span>
        <input class="input" type="email" name="email" value="{{.User.Email}}">
        <span class="help">Адрес, на который приходят коды.</span>
      </label>
      <label class="field">
        <span class="field-label">Телефон</span>
        <input class="input" type="tel" name="phone" value="{{.User.Phone}}" placeholder="+79990001122">
        <span class="help">В международном формате, для SMS.</span>
      </label>
    </div>
    <label class="field">
      <span class="field-label">Код подтверждения</span>
      <div class="field-with-btn">
        <input class="input code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code">
        <button type="submit" formaction="/me/send-code" formmethod="post" formnovalidate class="btn secondary" data-request-code>Запросить код</button>
      </div>
      <span class="help">Запросите код кнопкой рядом и введите его сюда.</span>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn primary">Сохранить контакты</button>
    </div>
  </form>
  <form action="/me/contacts/send-code" method="post" class="form form-tight">
    {{csrf .CSRF}}
    <div class="field-row">
      <label class="field">
        <span class="field-label">Отправить код подтверждения на канал</span>
        <select class="select" name="channel">
          <option value="email">Email</option>
          <option value="sms">SMS</option>
          <option value="telegram">Telegram</option>
        </select>
        <span class="help">Пришлём одноразовый код для подтверждения смены контактов.</span>
      </label>
      <div class="field form-actions">
        <button type="submit" class="btn secondary">Отправить код подтверждения</button>
      </div>
    </div>
  </form>
</section>

<section class="card">
  <div class="card-head">
    <h2>Каналы второго фактора</h2>
    <p>В каком порядке пробовать каналы при входе.</p>
  </div>
  <form action="/me/prefer" method="post" class="form">
    {{csrf .CSRF}}
    <div class="check-group">
      <label class="check"><input type="checkbox" name="channels" value="app_push" {{if hasChan .User.PreferChannels "app_push"}}checked{{end}}> <span>📱 Приложение Ligament (Push)</span></label>
      <label class="check"><input type="checkbox" name="channels" value="totp" {{if hasChan .User.PreferChannels "totp"}}checked{{end}}> <span>TOTP-приложение</span></label>
      <label class="check"><input type="checkbox" name="channels" value="telegram" {{if hasChan .User.PreferChannels "telegram"}}checked{{end}}> <span>Telegram</span></label>
      <label class="check"><input type="checkbox" name="channels" value="email" {{if hasChan .User.PreferChannels "email"}}checked{{end}}> <span>Email</span></label>
      <label class="check"><input type="checkbox" name="channels" value="sms" {{if hasChan .User.PreferChannels "sms"}}checked{{end}}> <span>SMS</span></label>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn primary">Сохранить каналы</button>
    </div>
  </form>
</section>

{{if eq .User.Source "ldap"}}
<section class="card">
  <div class="card-head">
    <h2>Смена пароля</h2>
    <p>Ваш пароль хранится в каталоге LDAP/Active Directory — меняйте его
    средствами каталога (портал самообслуживания AD или обращение к
    администратору домена).</p>
  </div>
</section>
{{else}}
<section class="card">
  <div class="card-head">
    <h2>Смена пароля</h2>
    <p>После смены пароля все сессии и доверенные устройства отзываются.</p>
  </div>
  <form action="/me/password" method="post" class="form">
    {{csrf .CSRF}}
    <div class="field-row">
      <label class="field">
        <span class="field-label">Текущий пароль</span>
        <input class="input" type="password" name="old_password" required autocomplete="current-password">
      </label>
      <label class="field">
        <span class="field-label">Новый пароль</span>
        <input class="input" type="password" name="new_password" required minlength="8" autocomplete="new-password">
        <span class="help">Минимум 8 символов.</span>
      </label>
    </div>
    <label class="field">
      <span class="field-label">Новый пароль ещё раз</span>
      <input class="input" type="password" name="new_password2" required minlength="8" autocomplete="new-password">
    </label>
    <div class="form-actions">
      <button type="submit" class="btn danger">Сменить пароль</button>
    </div>
  </form>
</section>
{{end}}
{{end}}
