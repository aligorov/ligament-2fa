{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>Группы пользователей</h1>
  <p class="page-sub">Локальные группы для распределения политик (VLAN, 2FA, RADIUS Push), прав доступа к приложениям OpenID Connect и структурирования пользователей.</p>
</header>

{{if .Edit}}
<section class="card card-edit-group" id="edit-group">
  <div class="card-head">
    <div class="card-head-title">
      <h2>Редактирование группы: {{.Edit.Name}}</h2>
      <p>Изменение названия, описания, приоритета, политик 2FA, VLAN и состава участников.</p>
    </div>
    <div>
      <a href="/admin/groups" class="btn secondary sm">✕ Отмена / Закрыть</a>
    </div>
  </div>
  <form action="/admin/groups/{{.Edit.ID}}" method="post" class="form wide">
    {{csrf .CSRF}}
    <div class="field-row">
      <label class="field field-flex-2">
        <span class="field-label">Название группы</span>
        <input class="input" type="text" name="name" value="{{.Edit.Name}}" required placeholder="Например: DevOps, Бухгалтерия">
      </label>
      <label class="field field-priority">
        <span class="field-label">Приоритет (1–100)</span>
        <input class="input mono" type="number" name="priority" min="1" max="100" value="{{.Edit.Priority}}" required>
        <span class="help">Вес при конфликте</span>
      </label>
      <label class="field field-flex-3">
        <span class="field-label">Описание</span>
        <input class="input" type="text" name="description" value="{{.Edit.Description}}" placeholder="Краткое назначение группы">
      </label>
    </div>

    {{if .LDAPGroups}}
    <div class="field">
      <div class="ad-picker-head">
        <span class="field-label field-label-flush">👥 Доступные группы из Active Directory / LDAP</span>
        <span class="muted ad-picker-hint">Нажмите на группу, чтобы быстро отметить или снять всех её участников</span>
      </div>
      <div class="select-grid ad-groups-grid">
        {{range .LDAPGroups}}
        <button type="button" class="select-chip btn-ad-group-select" data-ad-group="{{.}}" data-ad-group-cn="{{groupCN .}}" title="{{.}}">
          <div class="select-chip-label">
            <span class="ad-group-label">👥 {{groupCN .}}</span>
          </div>
        </button>
        {{end}}
      </div>
    </div>
    {{end}}

    <div class="field group-members-section">
      <div class="members-toolbar-row">
        <div class="members-head-left">
          <span class="field-label field-label-flush">Участники группы (отметьте пользователей)</span>
          <span class="badge neutral member-counter">Выбрано: <b class="member-count-num">{{len $.EditMemberIDs}}</b> из {{len .AllUsers}}</span>
        </div>
        <div class="members-head-right">
          <input type="text" class="input sm member-search-input" placeholder="🔍 Поиск участников...">
          <button type="button" class="btn secondary sm btn-select-all">Выбрать всех</button>
          <button type="button" class="btn secondary sm btn-clear-all">Снять всех</button>
        </div>
      </div>
      {{if .AllUsers}}
      <div class="select-grid members-grid">
        {{range .AllUsers}}
        <label class="select-chip member-chip"
               data-username="{{.Username}}"
               data-displayname="{{.DisplayName}}"
               data-ad-groups="{{range .LDAPGroups}}{{groupCN .}}|{{.}}|{{end}}">
          <input type="checkbox" name="members" value="{{.ID}}"{{if hasUUID $.EditMemberIDs .ID}} checked{{end}}>
          <div class="select-chip-label">
            <div class="member-name-row">
              <span class="user-chip-name">{{.Username}}</span>
              {{if .LDAPGroups}}<span class="badge neutral badge-ad" title="Группы AD: {{range .LDAPGroups}}{{groupCN .}} {{end}}">AD</span>{{end}}
            </div>
            {{if .DisplayName}}<span class="select-chip-sub">{{.DisplayName}}</span>{{end}}
          </div>
        </label>
        {{end}}
      </div>
      {{else}}
      <p class="muted">Пользователи не найдены.</p>
      {{end}}
    </div>

    <fieldset class="check-group">
      <legend>Каналы второго фактора для группы</legend>
      <label class="check"><input type="checkbox" name="prefer_channels" value="app_push"{{if hasChan .Edit.PreferChannels "app_push"}} checked{{end}}> <span>📱 Приложение (Push)</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="totp"{{if hasChan .Edit.PreferChannels "totp"}} checked{{end}}> <span>TOTP</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="telegram"{{if hasChan .Edit.PreferChannels "telegram"}} checked{{end}}> <span>Telegram</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="email"{{if hasChan .Edit.PreferChannels "email"}} checked{{end}}> <span>Email</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="sms"{{if hasChan .Edit.PreferChannels "sms"}} checked{{end}}> <span>SMS</span></label>
    </fieldset>

    <label class="check"><input type="checkbox" name="radius_push" value="1"{{if .Edit.RadiusPush}} checked{{end}}> <span>RADIUS Push — требовать Telegram-подтверждение для участников группы</span></label>

    <div class="field field-mt">
      <span class="field-label">📶 Сетевой сегмент / VLAN (Wi-Fi) для участников группы</span>
      <div class="vlan-row">
        <select class="select" id="group-vlan-select" data-vlan-input="group-vlan-input">
          <option value="">— По умолчанию (без группового VLAN) —</option>
          {{range $vid, $vname := $.VLANProfiles}}
            <option value="{{$vid}}"{{if eq $.Edit.VLAN $vid}} selected{{end}}>VLAN {{$vid}} — {{$vname}}</option>
          {{end}}
          <option value="custom"{{if and $.Edit.VLAN (not (index $.VLANProfiles $.Edit.VLAN))}} selected{{end}}>Свой номер VLAN...</option>
        </select>
        <input class="input mono vlan-input" type="text" name="vlan_id" id="group-vlan-input" placeholder="VLAN ID" value="{{.Edit.VLAN}}">
      </div>
      <span class="help">Автоматическая изоляция участников группы в указанный VLAN при подключении к корпоративному Wi-Fi или VPN (RFC 3580).</span>
    </div>

    <details class="advanced-details advanced-gap">
      <summary class="muted summary-toggle">⚙️ Дополнительные RADIUS-атрибуты группы (JSON)</summary>
      <label class="field field-mt-sm">
        <span class="field-label">RADIUS Reply <span class="muted">(JSON)</span></span>
        <textarea class="textarea mono" name="radius_reply" rows="3" placeholder='{"Mikrotik-Group": "vpn"}'>{{$.EditReplyJSON}}</textarea>
        <div class="radius-presets radius-presets-bar">
          <span class="muted presets-label">Шаблоны:</span>
          <button type="button" class="btn small outline" data-radius-preset="mikrotik_std">⚡ MikroTik: 30M/50M</button>
          <button type="button" class="btn small outline" data-radius-preset="mikrotik_vip">⚡ MikroTik: 100M (VIP)</button>
          <button type="button" class="btn small outline" data-radius-preset="mikrotik_guest">⚡ MikroTik: 5M/10M</button>
          <button type="button" class="btn small outline" data-radius-preset="unifi_vlan20">🌐 UniFi: VLAN 20</button>
          <button type="button" class="btn small outline" data-radius-preset="unifi_vlan30">🌐 UniFi: VLAN 30</button>
          <button type="button" class="btn small outline" data-radius-preset="workday">⏱️ Смена 8ч + 1 сессия</button>
          <button type="button" class="btn small outline" data-radius-preset="vpn_pool">🛡️ VPN: Пул адресов</button>
        </div>
        <span class="help">Специальные атрибуты Access-Accept для участников группы (скорость MikroTik-Rate-Limit, VLAN Tunnel-Private-Group-Id, тайм-ауты Session-Timeout, пулы Framed-Pool и др.).</span>
      </label>
    </details>

    <div class="apply-to-members-box">
      <label class="check">
        <input type="checkbox" name="apply_to_members" value="1">
        <span><b>Применить эти настройки ко всем текущим участникам группы прямо сейчас</b></span>
      </label>
      <span class="help help-indented">Принудительно обновит каналы 2FA, RADIUS Push, VLAN и RADIUS Reply в профилях всех пользователей, входящих в группу.</span>
    </div>

    <div class="form-actions form-actions-gap">
      <button type="submit" class="btn primary">Сохранить изменения</button>
      <a href="/admin/groups" class="btn secondary">Отмена</a>
    </div>
  </form>
</section>
{{else}}
<section class="card" id="new-group">
  <div class="card-head">
    <h2>Новая группа</h2>
    <p>Создание группы, назначение политик (VLAN, 2FA, Push) и начальных участников.</p>
  </div>
  <form action="/admin/groups" method="post" class="form wide">
    {{csrf .CSRF}}
    <div class="field-row">
      <label class="field field-flex-2">
        <span class="field-label">Название группы</span>
        <input class="input" type="text" name="name" required placeholder="Например: DevOps, Бухгалтерия, Руководство">
      </label>
      <label class="field field-priority">
        <span class="field-label">Приоритет (1–100)</span>
        <input class="input mono" type="number" name="priority" min="1" max="100" value="50" required>
        <span class="help">Вес при конфликте</span>
      </label>
      <label class="field field-flex-3">
        <span class="field-label">Описание</span>
        <input class="input" type="text" name="description" placeholder="Краткое описание группы">
      </label>
    </div>

    {{if .LDAPGroups}}
    <div class="field">
      <div class="ad-picker-head">
        <span class="field-label field-label-flush">👥 Доступные группы из Active Directory / LDAP</span>
        <span class="muted ad-picker-hint">Нажмите на группу, чтобы быстро отметить или снять всех её участников</span>
      </div>
      <div class="select-grid ad-groups-grid">
        {{range .LDAPGroups}}
        <button type="button" class="select-chip btn-ad-group-select" data-ad-group="{{.}}" data-ad-group-cn="{{groupCN .}}" title="{{.}}">
          <div class="select-chip-label">
            <span class="ad-group-label">👥 {{groupCN .}}</span>
          </div>
        </button>
        {{end}}
      </div>
    </div>
    {{end}}

    <div class="field group-members-section">
      <div class="members-toolbar-row">
        <div class="members-head-left">
          <span class="field-label field-label-flush">Участники группы</span>
          <span class="badge neutral member-counter">Выбрано: <b class="member-count-num">0</b> из {{len .AllUsers}}</span>
        </div>
        <div class="members-head-right">
          <input type="text" class="input sm member-search-input" placeholder="🔍 Поиск участников...">
          <button type="button" class="btn secondary sm btn-select-all">Выбрать всех</button>
          <button type="button" class="btn secondary sm btn-clear-all">Снять всех</button>
        </div>
      </div>
      {{if .AllUsers}}
      <div class="select-grid members-grid">
        {{range .AllUsers}}
        <label class="select-chip member-chip"
               data-username="{{.Username}}"
               data-displayname="{{.DisplayName}}"
               data-ad-groups="{{range .LDAPGroups}}{{groupCN .}}|{{.}}|{{end}}">
          <input type="checkbox" name="members" value="{{.ID}}">
          <div class="select-chip-label">
            <div class="member-name-row">
              <span class="user-chip-name">{{.Username}}</span>
              {{if .LDAPGroups}}<span class="badge neutral badge-ad" title="Группы AD: {{range .LDAPGroups}}{{groupCN .}} {{end}}">AD</span>{{end}}
            </div>
            {{if .DisplayName}}<span class="select-chip-sub">{{.DisplayName}}</span>{{end}}
          </div>
        </label>
        {{end}}
      </div>
      {{else}}
      <p class="muted">Пользователи ещё не созданы.</p>
      {{end}}
    </div>

    <fieldset class="check-group">
      <legend>Каналы второго фактора для группы</legend>
      <label class="check"><input type="checkbox" name="prefer_channels" value="app_push"> <span>📱 Приложение (Push)</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="totp"> <span>TOTP</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="telegram"> <span>Telegram</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="email"> <span>Email</span></label>
      <label class="check"><input type="checkbox" name="prefer_channels" value="sms"> <span>SMS</span></label>
    </fieldset>

    <label class="check"><input type="checkbox" name="radius_push" value="1"> <span>RADIUS Push — требовать Telegram-подтверждение для участников группы</span></label>

    <div class="field field-mt">
      <span class="field-label">📶 Сетевой сегмент / VLAN (Wi-Fi) для участников группы</span>
      <div class="vlan-row">
        <select class="select" id="new-group-vlan-select" data-vlan-input="new-group-vlan-input">
          <option value="">— По умолчанию (без группового VLAN) —</option>
          {{range $vid, $vname := $.VLANProfiles}}
            <option value="{{$vid}}">VLAN {{$vid}} — {{$vname}}</option>
          {{end}}
          <option value="custom">Свой номер VLAN...</option>
        </select>
        <input class="input mono vlan-input" type="text" name="vlan_id" id="new-group-vlan-input" placeholder="VLAN ID">
      </div>
      <span class="help">Автоматическая изоляция участников группы в указанный VLAN при подключении к корпоративному Wi-Fi или VPN (RFC 3580).</span>
    </div>

    <details class="advanced-details advanced-gap">
      <summary class="muted summary-toggle">⚙️ Дополнительные RADIUS-атрибуты группы (JSON)</summary>
      <label class="field field-mt-sm">
        <span class="field-label">RADIUS Reply <span class="muted">(JSON)</span></span>
        <textarea class="textarea mono" name="radius_reply" rows="3" placeholder='{"Mikrotik-Group": "vpn"}'></textarea>
        <div class="radius-presets radius-presets-bar">
          <span class="muted presets-label">Шаблоны:</span>
          <button type="button" class="btn small outline" data-radius-preset="mikrotik_std">⚡ MikroTik: 30M/50M</button>
          <button type="button" class="btn small outline" data-radius-preset="mikrotik_vip">⚡ MikroTik: 100M (VIP)</button>
          <button type="button" class="btn small outline" data-radius-preset="mikrotik_guest">⚡ MikroTik: 5M/10M</button>
          <button type="button" class="btn small outline" data-radius-preset="unifi_vlan20">🌐 UniFi: VLAN 20</button>
          <button type="button" class="btn small outline" data-radius-preset="unifi_vlan30">🌐 UniFi: VLAN 30</button>
          <button type="button" class="btn small outline" data-radius-preset="workday">⏱️ Смена 8ч + 1 сессия</button>
          <button type="button" class="btn small outline" data-radius-preset="vpn_pool">🛡️ VPN: Пул адресов</button>
        </div>
        <span class="help">Специальные атрибуты Access-Accept для участников группы (скорость MikroTik-Rate-Limit, VLAN Tunnel-Private-Group-Id, тайм-ауты Session-Timeout, пулы Framed-Pool и др.).</span>
      </label>
    </details>

    <div class="form-actions">
      <button type="submit" class="btn primary">Создать группу</button>
    </div>
  </form>
</section>
{{end}}

<section class="card">
  <div class="card-head">
    <h2>Список групп</h2>
    <p>Всего создано локальных групп: {{len .Groups}}.</p>
  </div>
  {{if .Groups}}
  <div class="table-wrap">
    <table class="table">
      <tr>
        <th>Приоритет</th>
        <th>Название</th>
        <th>Описание</th>
        <th>Каналы 2FA</th>
        <th>VLAN (Wi-Fi)</th>
        <th>RADIUS Push</th>
        <th>Участников</th>
        <th>Создана</th>
        <th>Действия</th>
      </tr>
      {{range .Groups}}
      <tr>
        <td><span class="badge neutral" title="Вес группы при участии пользователя в нескольких группах (1–100, чем выше, тем приоритетнее)">{{.Priority}}</span></td>
        <td class="cell-strong"><span class="badge info">{{.Name}}</span></td>
        <td>{{if .Description}}{{.Description}}{{else}}<span class="muted">—</span>{{end}}</td>
        <td>
          {{if .PreferChannels}}
            {{range .PreferChannels}}
              {{if eq . "app_push"}}
                <span class="badge ok">📱 app_push</span>
              {{else}}
                <span class="badge neutral">{{.}}</span>
              {{end}}
            {{end}}
          {{else}}
            <span class="muted">—</span>
          {{end}}
        </td>
        <td>{{if .VLAN}}<span class="badge info" title="Сетевой сегмент: Tunnel-Private-Group-Id {{.VLAN}}">{{vlanDesc $.VLANProfiles .VLAN}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
        <td>{{if .RadiusPush}}<span class="badge ok">да</span>{{else}}<span class="badge neutral">нет</span>{{end}}</td>
        <td><span class="badge neutral">{{.MemberCount}} польз.</span></td>
        <td>{{dt .CreatedAt}}</td>
        <td class="row-actions">
          <a class="btn secondary sm" href="/admin/groups/{{.ID}}">Участники / Изменить</a>
          <form action="/admin/groups/{{.ID}}/delete" method="post" class="form-inline">
            {{csrf $.CSRF}}
            <button type="submit" class="btn danger sm" data-confirm="Удалить группу {{.Name}}?">Удалить</button>
          </form>
        </td>
      </tr>
      {{end}}
    </table>
  </div>
  {{else}}
  <div class="empty">
    <p>Локальных групп пока нет — создайте первую группу в форме выше.</p>
  </div>
  {{end}}
</section>

{{end}}
