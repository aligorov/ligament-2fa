{{define "layout"}}{{template "layout_center" .}}{{end}}
{{define "content"}}
<div class="login-card">
  <div class="login-brand">
      {{if .Brand.Logo}}<img class="brand-logo" src="{{.Brand.Logo}}" alt="logo">
      {{else if .Brand.Name}}<span class="brand-mark">{{if .Brand.Mark}}{{.Brand.Mark}}{{else}}{{slice .Brand.Name 0 1}}{{end}}</span>{{.Brand.Name}}
      {{else}}<span class="brand-mark">L</span>Ligament{{end}}
    </div>
  <h1>Вход</h1>
  <p class="page-sub">{{if .Brand.Description}}{{.Brand.Description}}{{else}}Имя пользователя, пароль и — если включён второй
  фактор — код из приложения или сообщения.{{end}}</p>
  {{with .Err}}<div class="flash err"><span class="flash-icon">⚠️</span>{{.}}</div>{{end}}
  {{if .NeedCode}}<div class="flash ok"><span class="flash-icon">🔐</span>Введите код второго фактора.{{if .Info}} {{.Info}}{{end}}</div>{{end}}
  <form action="/login" method="post" class="form">
    {{if .Next}}<input type="hidden" name="next" value="{{.Next}}">{{end}}
    <label class="field">
      <span class="field-label">Имя пользователя</span>
      <input class="input" type="text" name="username" value="{{.Prefill}}" required autofocus autocomplete="username">
    </label>
    <label class="field">
      <span class="field-label">Пароль</span>
      <input class="input" type="password" name="password" required autocomplete="current-password">
    </label>
    <label class="field">
      <span class="field-label">Код 2FA (если включён)</span>
      <input class="input code-input" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" placeholder="например, 123456">
      <span class="help">Шестизначный код из приложения-аутентификатора или сообщения.</span>
    </label>
    <label class="check">
      <input type="checkbox" name="remember" value="1">
      <span>Запомнить это устройство<span class="help">30 дней без кода на этом браузере</span></span>
    </label>
    <div class="form-actions">
      <button type="submit" class="btn primary">Войти</button>
      {{if and .NeedCode .CanEmail}}
      <button type="submit" name="action" value="send_email" class="btn secondary">Отправить на почту</button>
      {{end}}
      {{if and .NeedCode .CanSMS}}
      <button type="submit" name="action" value="send_sms" class="btn secondary">Отправить код по SMS</button>
      {{end}}
    </div>
  </form>
</div>
{{end}}
