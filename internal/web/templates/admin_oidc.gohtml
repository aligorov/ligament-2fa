{{define "layout"}}{{template "layout_app" .}}{{end}}
{{define "content"}}
<header class="page-head">
  <h1>OpenID Connect</h1>
  <p class="page-sub">Клиентские приложения (relying party): направляют
  пользователей на вход в Ligament и получают ID-токен. Discovery-адрес для
  настройки приложений — <span class="mono">/.well-known/openid-configuration</span>.</p>
</header>

{{if .OneTimeClientID}}
<section class="card">
  <div class="card-head">
    <h2><span class="card-icon">🔑</span>Клиент создан</h2>
    <p>Секрет показывается только один раз — сохраните его сейчас.</p>
  </div>
  <p>client_id:</p>
  <pre class="one-time">{{.OneTimeClientID}}</pre>
  {{if .OneTimeSecret}}
  <p>client_secret:</p>
  <pre class="one-time">{{.OneTimeSecret}}</pre>
  {{end}}
</section>
{{end}}

<section class="card">
  <div class="card-head">
    <h2><span class="card-icon">🧩</span>Клиентские приложения</h2>
    <p>Внешние приложения, которым разрешён вход через Ligament.</p>
  </div>
  {{if .Clients}}
  <div class="table-wrap">
    <table class="table">
      <tr><th>client_id</th><th>Название</th><th>Redirect URI</th><th>Тип</th><th>Доступ</th><th>Создан</th><th>Действия</th></tr>
      {{range .Clients}}
      <tr>
        <td class="mono">{{.ClientID}}</td>
        <td>{{.Name}}</td>
        <td class="mono">{{range .RedirectURIs}}{{.}}<br>{{end}}</td>
        <td>{{if .IsPublic}}<span class="badge neutral">public (PKCE)</span>{{else}}<span class="badge neutral">confidential</span>{{end}}</td>
        <td>
          {{if and (eq (len .AllowedUsers) 0) (eq (len .AllowedGroups) 0)}}
            <span class="badge ok">Всем пользователям</span>
          {{else}}
            <span class="badge warn" title="Группы: {{join .AllowedGroups ", "}} | Пользователи: {{join .AllowedUsers ", "}}">
              Ограничен ({{len .AllowedGroups}} гр., {{len .AllowedUsers}} польз.)
            </span>
          {{end}}
        </td>
        <td>{{dt .CreatedAt}}</td>
        <td class="row-actions">
          <a class="btn secondary sm" href="/admin/oidc/clients/{{.ID}}/edit">Изменить</a>
          <form action="/admin/oidc/clients/{{.ID}}/delete" method="post" class="form-inline">
            {{csrf $.CSRF}}
            <button type="submit" class="btn danger sm" data-confirm="Удалить приложение {{.Name}}?">Удалить</button>
          </form>
        </td>
      </tr>
      {{end}}
    </table>
  </div>
  {{else}}
  <div class="empty"><p>Клиентов пока нет — создайте первое приложение ниже.</p></div>
  {{end}}
</section>

<section class="card">
  <div class="card-head" style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
    <div>
      <h2><span class="card-icon">➕</span>Новое приложение</h2>
      <p>client_id и client_secret сгенерируются автоматически (или можно указать свои); секрет
      покажется один раз. Public-клиенты (SPA/мобилки) секрет не получают — только PKCE.</p>
    </div>
    <button type="button" class="btn sm neutral" id="btn-preset-playground" style="white-space:nowrap;">⚡ Шаблон openidconnect.net</button>
  </div>
  <form action="/admin/oidc/clients" method="post" class="form">
    {{csrf .CSRF}}
    <label class="field">
      <span class="field-label">Название приложения</span>
      <input class="input" type="text" name="name" id="oidc-name" placeholder="Grafana, Proxmox PVE, Nextcloud" required>
    </label>
    <label class="field">
      <span class="field-label">Redirect URI (по одному в строке)</span>
      <textarea class="input mono" name="redirect_uris" id="oidc-redirect-uris" rows="2" placeholder="https://grafana.example.com/login/generic_oauth" required></textarea>
      <span class="help">Строгое совпадение: куда перенаправлять код после входа.</span>
    </label>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
      <label class="field">
        <span class="field-label">Client ID (опционально)</span>
        <input class="input mono" type="text" name="client_id" id="oidc-client-id" placeholder="Автоматически (mfa_...)">
        <span class="help">Оставьте пустым для генерации случайного ID</span>
      </label>
      <label class="field">
        <span class="field-label">Client Secret (опционально)</span>
        <input class="input mono" type="text" name="client_secret" id="oidc-client-secret" placeholder="Автоматически">
        <span class="help">Оставьте пустым для генерации случайного секрета</span>
      </label>
    </div>
    <label class="check">
      <input type="checkbox" name="is_public" id="oidc-is-public" value="1">
      <span>Public-клиент (без секрета, PKCE S256 обязателен)</span>
    </label>

    <details class="advanced-details" style="margin: 8px 0 16px;">
      <summary class="muted" style="cursor: pointer; font-size: 0.95rem; user-select: none; font-weight: 600;">
        🔒 Контроль доступа к приложению <span class="badge neutral" style="font-weight:normal;">По умолчанию: открыт всем</span>
      </summary>
      <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 12px;">
        <p class="help" style="margin:0;">Если ни одна группа и ни один пользователь не выбраны — доступ открыт всем активным пользователям. Системные администраторы имеют доступ всегда.</p>

        {{if .AllGroups}}
        <div class="field">
          <span class="field-label">Локальные группы</span>
          <div class="select-grid" style="max-height: 140px;">
            {{range .AllGroups}}
            <label class="select-chip">
              <input type="checkbox" name="allowed_groups" value="{{.Name}}">
              <div class="select-chip-label">
                <span>{{.Name}}</span>
                {{if .Description}}<span class="select-chip-sub">{{.Description}}</span>{{end}}
              </div>
            </label>
            {{end}}
          </div>
        </div>
        {{end}}

        {{if .LDAPGroups}}
        <div class="field">
          <span class="field-label">Группы LDAP/Active Directory</span>
          <div class="select-grid" style="max-height: 140px;">
            {{range .LDAPGroups}}
            <label class="select-chip">
              <input type="checkbox" name="allowed_groups" value="{{.}}">
              <div class="select-chip-label">
                <span>{{.}}</span>
              </div>
            </label>
            {{end}}
          </div>
        </div>
        {{end}}

        {{if .AllUsers}}
        <div class="field">
          <span class="field-label">Отдельные пользователи</span>
          <div class="select-grid" style="max-height: 140px;">
            {{range .AllUsers}}
            <label class="select-chip">
              <input type="checkbox" name="allowed_users" value="{{.Username}}">
              <div class="select-chip-label">
                <span>{{.Username}}</span>
                {{if .DisplayName}}<span class="select-chip-sub">{{.DisplayName}}</span>{{end}}
              </div>
            </label>
            {{end}}
          </div>
        </div>
        {{end}}

        <label class="field">
          <span class="field-label">Дополнительные группы / DN вручную (по одной в строке)</span>
          <textarea class="input mono" name="manual_groups" rows="2" placeholder="CN=Proxmox-Users,OU=Groups,DC=company,DC=local"></textarea>
          <span class="help">Укажите DN или имена групп Active Directory / OpenLDAP, если их нет в списке выше.</span>
        </label>
      </div>
    </details>

    <div class="form-actions">
      <button type="submit" class="btn primary">Создать клиента</button>
    </div>
  </form>
</section>
<script>
document.getElementById('btn-preset-playground')?.addEventListener('click', function() {
  var name = document.getElementById('oidc-name');
  var uris = document.getElementById('oidc-redirect-uris');
  var cid = document.getElementById('oidc-client-id');
  var sec = document.getElementById('oidc-client-secret');
  var pub = document.getElementById('oidc-is-public');
  if (name) name.value = 'openidconnect.net';
  if (uris) uris.value = 'https://openidconnect.net/callback';
  if (cid) cid.value = 'kbyuFDidLLm280LiWVfiazOqjO3ty8KH';
  if (sec) sec.value = '60Op4HFM0I8ajz0WdiStAbziZ-VFQttXuxixHHs2R7r7-CW8GR79l-mmLqMhc-Sa';
  if (pub) pub.checked = false;
});
</script>
{{end}}
